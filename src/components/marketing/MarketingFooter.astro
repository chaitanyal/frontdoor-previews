---
/**
 * Marketing footer with caller-supplied URLs for different route depths.
 * showHome enables the optional home link.
 */
const {
  homeHref,
  privacyHref,
  contactHref,
  showHome = false,
} = Astro.props;
---

<footer class="bg-warm-200 px-5 py-8 lg:px-8">
  <div class="mx-auto flex max-w-7xl flex-col gap-5 border-t border-slate-200 pt-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-semibold">FrontDoor Health</p>
      <p class="mt-1 text-sm text-slate-500">
        A Website That Feels Like Your Practice
      </p>
    </div>
    <div class="flex gap-6 text-sm text-slate-500">
      {showHome && <a class="transition-colors hover:text-slate-950" href={homeHref}>Home</a>}
      <a class="transition-colors hover:text-slate-950" href={privacyHref}>Privacy</a>
      <a class="transition-colors hover:text-slate-950" href={contactHref}>Contact</a>
    </div>
  </div>
</footer>
