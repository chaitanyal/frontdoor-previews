---
const formScript = `
(() => {
  const form = document.getElementById('preview-request-form');
  const submitButton = document.getElementById('preview-request-submit');
  const status = document.getElementById('preview-request-status');
  if (!form || !submitButton || !status) return;
  let isSubmitting = false;
  let hasSubmitted = false;

  function showStatus(message, type) {
    status.textContent = message;
    status.hidden = false;
    status.dataset.statusType = type;
  }

  function getUtmCampaign() {
    return window.FrontdoorAttribution?.getUtmCampaign?.() || null;
  }

  function normalizeWebsiteUrl(value) {
    const raw = String(value || '').trim();
    if (!raw) return '';
    const candidate = /^https?:\\/\\//i.test(raw) ? raw : \`https://\${raw}\`;

    try {
      const url = new URL(candidate);
      if (!['http:', 'https:'].includes(url.protocol)) return null;
      if (!url.hostname.includes('.') || url.username || url.password) return null;
      url.hash = '';
      return url.toString();
    } catch (_error) {
      return null;
    }
  }

  function isLocalPreview() {
    return (
      window.location.protocol === 'file:' ||
      window.location.hostname === 'localhost' ||
      window.location.hostname === '127.0.0.1' ||
      window.location.hostname === '::1' ||
      window.location.hostname === '[::1]'
    );
  }

  function sendPreviewRequestedEvent(utmCampaign, practiceName, specialty, website) {
    if (isLocalPreview()) return;

    fetch('https://analytics.frontdoor.health/event', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        event_type: 'preview_requested',
        utm_campaign: utmCampaign,
        page_path: window.location.pathname,
        referrer: document.referrer || '',
        title: document.title || '',
        timestamp: new Date().toISOString(),
        practice_name: practiceName,
        specialty,
        has_website: Boolean(website),
      }),
      keepalive: true,
    }).catch(() => {});
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isSubmitting || hasSubmitted) return;

    const formData = new FormData(form);
    const name = String(formData.get('name') || '').trim();
    const practiceName = String(formData.get('practiceName') || '').trim();
    const specialty = String(formData.get('specialty') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const websiteInput = String(formData.get('websiteUrl') || '').trim();
    const website = normalizeWebsiteUrl(websiteInput);

    if (!name) return showStatus('Please enter your name.', 'error');
    if (!practiceName) return showStatus('Please enter your practice name.', 'error');
    if (!specialty) return showStatus('Please select a specialty.', 'error');
    if (!email || !form.elements.email.checkValidity()) {
      return showStatus('Please enter a valid email address.', 'error');
    }
    if (websiteInput && !website) {
      return showStatus('Please enter a valid website URL.', 'error');
    }

    const turnstileToken = window.turnstile?.getResponse();
    if (!turnstileToken) {
      return showStatus('Please complete the verification check.', 'error');
    }

    isSubmitting = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    status.hidden = true;

    try {
      const utmCampaign = getUtmCampaign();
      const response = await fetch('/api/preview-request', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name,
          practiceName,
          specialty,
          email,
          websiteUrl: website,
          companyWebsite: formData.get('companyWebsite'),
          utm_campaign: utmCampaign,
          turnstileToken,
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.ok !== true) {
        throw new Error(result.error || 'Unable to send your request right now.');
      }
      if (result.accepted === true) {
        sendPreviewRequestedEvent(utmCampaign, practiceName, specialty, website);
        window.FrontdoorGoogleAds?.trackGoogleAdsPreviewRequestConversion?.();
      }
      form.reset();
      window.turnstile?.reset();
      hasSubmitted = true;
      submitButton.textContent = 'Request Sent';
      showStatus('Thanks. I will review your practice website and follow up.', 'success');
    } catch (error) {
      window.turnstile?.reset();
      showStatus(error.message || 'Unable to send your request right now.', 'error');
      submitButton.disabled = false;
      submitButton.textContent = 'Request a Free Preview';
    } finally {
      isSubmitting = false;
    }
  });
})();
`;
---

<form id="preview-request-form">
  <label for="name">Name</label>
  <input id="name" name="name" required maxlength="100" />

  <label for="practiceName">Practice name</label>
  <input id="practiceName" name="practiceName" required maxlength="150" />

  <label for="specialty">Specialty</label>
  <select id="specialty" name="specialty" required>
    <option value="">Select a specialty</option>
    <option value="Psychiatry">Psychiatry</option>
  </select>

  <label for="email">Email</label>
  <input id="email" name="email" type="email" required maxlength="254" />

  <label for="website">Current practice website</label>
  <input id="website" name="websiteUrl" maxlength="500" />

  <label for="companyWebsite">Company website</label>
  <input id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off" />

  <p id="preview-request-status" role="status" aria-live="polite" hidden></p>
  <button id="preview-request-submit" type="submit">Request a Free Preview</button>
</form>

<script is:inline set:html={formScript}></script>
