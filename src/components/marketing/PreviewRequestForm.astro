---
const formScript = `
window.lucide?.createIcons();

(() => {
  const form = document.getElementById('preview-request-form');
  const submitButton = document.getElementById('preview-request-submit');
  const status = document.getElementById('preview-request-status');
  if (!form || !submitButton || !status) return;
  let isSubmitting = false;
  let hasSubmitted = false;

  function showStatus(message, type) {
    status.textContent = message;
    status.className = 'rounded-2xl px-4 py-3 text-sm font-medium ' + (
      type === 'success'
        ? 'bg-green-50 text-green-800'
        : 'bg-amber-50 text-amber-900'
    );
  }

  function getUtmCampaign() {
    return window.FrontdoorAttribution?.getUtmCampaign?.() || null;
  }

  function normalizeWebsiteUrl(value) {
    const raw = String(value || '').trim();
    if (!raw) return '';
    const candidate = /^https?:\\/\\//i.test(raw) ? raw : \`https://\${raw}\`;

    try {
      const url = new URL(candidate);
      if (!['http:', 'https:'].includes(url.protocol)) return null;
      if (!url.hostname.includes('.') || url.username || url.password) return null;
      url.hash = '';
      return url.toString();
    } catch (_error) {
      return null;
    }
  }

  function isLocalPreview() {
    return (
      window.location.protocol === 'file:' ||
      window.location.hostname === 'localhost' ||
      window.location.hostname === '127.0.0.1' ||
      window.location.hostname === '::1' ||
      window.location.hostname === '[::1]'
    );
  }

  function sendPreviewRequestedEvent(utmCampaign, practiceName, specialty, website) {
    if (isLocalPreview()) return;

    fetch('https://analytics.frontdoor.health/event', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        event_type: 'preview_requested',
        utm_campaign: utmCampaign,
        page_path: window.location.pathname,
        referrer: document.referrer || '',
        title: document.title || '',
        timestamp: new Date().toISOString(),
        practice_name: practiceName,
        specialty,
        has_website: Boolean(website),
      }),
      keepalive: true,
    }).catch(() => {});
  }

  function trackGoogleAdsPreviewRequestConversion() {
    try {
      window.FrontdoorGoogleAds?.trackGoogleAdsPreviewRequestConversion?.();
    } catch (_error) {}
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isSubmitting || hasSubmitted) return;

    const formData = new FormData(form);
    const name = String(formData.get('name') || '').trim();
    const practiceName = String(formData.get('practiceName') || '').trim();
    const specialty = String(formData.get('specialty') || '').trim();
    const email = String(formData.get('email') || '').trim();
    const websiteInput = String(formData.get('websiteUrl') || '').trim();
    const website = normalizeWebsiteUrl(websiteInput);

    if (!name) {
      showStatus('Please enter your name.', 'error');
      return;
    }
    if (!practiceName) {
      showStatus('Please enter your practice name.', 'error');
      return;
    }
    if (!specialty) {
      showStatus('Please select a specialty.', 'error');
      return;
    }
    if (!email || !form.elements.email.checkValidity()) {
      showStatus('Please enter a valid email address.', 'error');
      return;
    }
    if (websiteInput && !website) {
      showStatus('Please enter a valid website URL.', 'error');
      return;
    }

    const turnstileToken = window.turnstile?.getResponse();
    if (!turnstileToken) {
      showStatus('Please complete the verification check.', 'error');
      return;
    }

    isSubmitting = true;
    submitButton.disabled = true;
    submitButton.textContent = 'Sending...';
    status.className = 'hidden rounded-2xl px-4 py-3 text-sm font-medium';

    try {
      const utmCampaign = getUtmCampaign();
      const response = await fetch('/api/preview-request', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name,
          practiceName,
          specialty,
          email,
          websiteUrl: website,
          companyWebsite: formData.get('companyWebsite'),
          utm_campaign: utmCampaign,
          turnstileToken,
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || result.ok !== true) {
        throw new Error(result.error || 'Unable to send your request right now.');
      }
      if (result.accepted === true) {
        sendPreviewRequestedEvent(utmCampaign, practiceName, specialty, website);
        trackGoogleAdsPreviewRequestConversion();
      }
      form.reset();
      window.turnstile?.reset();
      hasSubmitted = true;
      submitButton.textContent = 'Request Sent';
      showStatus('Thanks. I will review your practice website and follow up.', 'success');
    } catch (error) {
      window.turnstile?.reset();
      showStatus(error.message || 'Unable to send your request right now.', 'error');
      submitButton.disabled = false;
      submitButton.textContent = 'Request a Free Preview';
    } finally {
      isSubmitting = false;
    }
  });
})();
`;
---

<section id="contact" class="bg-brand-700 px-5 py-16 text-white lg:px-8 lg:py-20">
  <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-200">Start with a free preview</p>
      <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight md:text-4xl">
        See your future website before committing.
      </h2>
      <p class="mt-5 text-lg leading-8 text-blue-100">
        Share a few details about your practice. We'll turn them into a personalized preview you can review first.
      </p>
    </div>

    <form id="preview-request-form" class="rounded-[32px] bg-white/95 p-8 text-slate-950 shadow-[0_20px_70px_rgba(0,0,0,0.18)] md:p-10">
      <div class="space-y-6">
        <div>
          <label for="name" class="text-sm font-medium text-slate-700">Name</label>
          <input id="name" name="name" autocomplete="name" required maxlength="100" class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-4 text-base outline-none focus:border-brand-700 focus:ring-4 focus:ring-brand-50" placeholder="Your name" />
        </div>
        <div>
          <label for="practiceName" class="text-sm font-medium text-slate-700">Practice name</label>
          <input id="practiceName" name="practiceName" autocomplete="organization" required maxlength="150" class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-4 text-base outline-none focus:border-brand-700 focus:ring-4 focus:ring-brand-50" placeholder="Your practice name" />
        </div>
        <div>
          <label for="specialty" class="text-sm font-medium text-slate-700">Specialty</label>
          <!-- Keep these options synchronized with ALLOWED_SPECIALTIES in functions/api/preview-request.js. -->
          <select id="specialty" name="specialty" required class="mt-2 h-[58px] w-full rounded-2xl border border-slate-300 bg-white px-4 py-4 text-base outline-none focus:border-brand-700 focus:ring-4 focus:ring-brand-50">
            <option value="" selected disabled>Select a specialty</option>
            <option value="Cardiology">Cardiology</option>
            <option value="Dermatology">Dermatology</option>
            <option value="Endocrinology">Endocrinology</option>
            <option value="ENT / Otolaryngology">ENT / Otolaryngology</option>
            <option value="Gastroenterology">Gastroenterology</option>
            <option value="Internal Medicine">Internal Medicine</option>
            <option value="Neurology">Neurology</option>
            <option value="OB/GYN">OB/GYN</option>
            <option value="Ophthalmology">Ophthalmology</option>
            <option value="Orthopedics">Orthopedics</option>
            <option value="Pain Management">Pain Management</option>
            <option value="Pediatrics">Pediatrics</option>
            <option value="Physical Therapy">Physical Therapy</option>
            <option value="Plastic Surgery">Plastic Surgery</option>
            <option value="Primary Care / Family Medicine">Primary Care / Family Medicine</option>
            <option value="Psychiatry">Psychiatry</option>
            <option value="Psychology">Psychology</option>
            <option value="Pulmonology">Pulmonology</option>
            <option value="Rheumatology">Rheumatology</option>
            <option value="Sleep Medicine">Sleep Medicine</option>
            <option value="Therapy / Counseling">Therapy / Counseling</option>
            <option value="Urgent Care">Urgent Care</option>
            <option value="Urology">Urology</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div>
          <label for="email" class="text-sm font-medium text-slate-700">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-4 text-base outline-none focus:border-brand-700 focus:ring-4 focus:ring-brand-50" placeholder="you@example.com" />
        </div>
        <div>
          <label for="website" class="text-sm font-medium text-slate-700">Current practice website (optional)</label>
          <input id="website" name="websiteUrl" inputmode="url" autocomplete="url" maxlength="500" class="mt-2 w-full rounded-2xl border border-slate-300 px-4 py-4 text-base outline-none focus:border-brand-700 focus:ring-4 focus:ring-brand-50" placeholder="https://yourpractice.com" />
          <p class="mt-2 text-sm text-slate-500">Don't have a website yet? Leave this blank.</p>
        </div>
        <div class="hidden" aria-hidden="true">
          <label for="companyWebsite">Company website</label>
          <input id="companyWebsite" name="companyWebsite" tabindex="-1" autocomplete="off" />
        </div>
        <div class="cf-turnstile" data-sitekey="0x4AAAAAADeia3tun_3f12Pa"></div>
        <p id="preview-request-status" class="hidden rounded-2xl px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></p>
        <button id="preview-request-submit" type="submit" class="w-full rounded-2xl bg-brand-700 px-6 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-brand-900 disabled:cursor-not-allowed disabled:opacity-70">Request a Free Preview</button>
      </div>
    </form>
  </div>
</section>

<script is:inline set:html={formScript}></script>
