---
interface Props {
  assetHref: string;
  detail?: string;
  target: string;
}

const { assetHref, detail, target } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{target} Astro build proof</title>
  </head>
  <body>
    <main>
      <img src={assetHref} alt="FrontDoor Health" width="240" />
      <h1>{target} Astro build proof</h1>
      {detail && <p>{detail}</p>}
      <p>This static page is generated by the parallel Astro builder.</p>
    </main>
  </body>
</html>
