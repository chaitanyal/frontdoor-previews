---
interface Props {
  includeCtas?: boolean;
  includeProviderCard?: boolean;
  providerHref?: string;
  resourceHref?: string;
}

const {
  includeCtas = true,
  includeProviderCard = false,
  providerHref = './providers/analytics-fixture/',
  resourceHref = './assets/resources/fixture.pdf',
} = Astro.props;

const interactionScript = `
(() => {
  async function copyText(value) {
    if (navigator.clipboard?.writeText && window.isSecureContext) {
      await navigator.clipboard.writeText(value);
      return true;
    }
    return false;
  }

  function showCopyToast() {
    const toast = document.querySelector('[data-copy-toast]');
    if (!toast) return;
    toast.hidden = false;
  }

  document.querySelectorAll('[data-copy-email]').forEach((button) => {
    button.addEventListener('click', async () => {
      const email = button.getAttribute('data-copy-email') || '';
      try {
        if (!await copyText(email)) throw new Error('Copy command failed');
        showCopyToast();
      } catch (_error) {
        window.prompt('Copy email address:', email);
      }
    });
  });

  document.querySelectorAll('[data-card-href]').forEach((card) => {
    function navigate() {
      window.location.href = card.getAttribute('data-card-href');
    }
    card.addEventListener('click', navigate);
    card.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      navigate();
    });
  });
})();
`;
---

<div>
  {includeCtas && (
    <>
      <button
        type="button"
        data-copy-email="fixture@example.com"
        data-frontdoor-cta="email"
      >
        Email
      </button>
      <a href="tel:+15125550100" data-frontdoor-cta="phone">Phone</a>
      <a href="https://example.com/new-patient" data-frontdoor-cta="newPatient">
        New patient
      </a>
      <a href="https://example.com/patient-portal" data-frontdoor-cta="existingPatient">
        Existing patient
      </a>
      <a href="https://maps.example.com/fixture" data-frontdoor-cta="directions">
        Directions
      </a>
      <a href={resourceHref} data-frontdoor-cta="resource">Resource</a>
      <p data-copy-toast hidden>Email copied</p>
    </>
  )}
  {includeProviderCard && (
    <article data-card-href={providerHref} role="link" tabindex="0">
      Provider fixture
    </article>
  )}
</div>

<script is:inline set:html={interactionScript}></script>
