---
/**
 * Optional symptom-first section, with optional verified practice-help copy.
 * Replacement preserves #conditions for existing provider/profile links. Treatment
 * links use configured slugs; appointment actions remain in existing page sections.
 */
import { careGuidanceContent } from '../../lib/care-guidance.mjs';
import { HOME_SECTION_IDS } from '../../lib/home-sections.mjs';

interface Props { config: Record<string, any>; }
const { config } = Astro.props;
const content = careGuidanceContent(config);
const sectionId = config.careGuidance?.replaceConditions
  ? HOME_SECTION_IDS.conditions
  : HOME_SECTION_IDS.careGuidance;
const treatments = (config.treatments || []).filter((treatment) =>
  config.careGuidance?.practiceHelp?.treatmentSlugs?.includes(treatment.slug),
);
---

{content && (
  <section id={sectionId} class="home-care-guidance section scroll-mt-24" aria-labelledby="care-guidance-title">
    <div class="section-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Finding the right care</p>
        <h2 id="care-guidance-title" class="section-title">{content.heading}</h2>
        <p data-section-summary class="section-copy">{content.introduction}</p>
      </div>
      <ul class="care-concerns mt-10 grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-2 lg:grid-cols-3" aria-label="Recognizable concerns">
        {content.concerns.map((concern) => (
          <li class="border-t pt-5">
            <h3 class="care-concern-title text-lg font-semibold leading-snug">{concern.title}</h3>
            <p class="care-concern-copy mt-3 text-base leading-7">{concern.description}</p>
          </li>
        ))}
      </ul>
      {content.practiceHelp && <div class="care-guidance-explanation mt-8 border-t pt-6">
        <div class="max-w-3xl">
          <h3 class="care-concern-title text-xl font-semibold">{content.practiceHelp.heading}</h3>
          <p class="care-concern-copy mt-3 text-base leading-7">{content.practiceHelp.summary}</p>
          {treatments.length > 0 && <div class="mt-3 flex flex-wrap gap-x-6">
            {treatments.map((treatment) => (
              <a href={`./treatment/${treatment.slug}/`} class="nav-link inline-flex min-h-[44px] items-center text-brand-primary underline underline-offset-4">Learn about {treatment.name}</a>
            ))}
          </div>}
        </div>
      </div>}
    </div>
  </section>
)}
