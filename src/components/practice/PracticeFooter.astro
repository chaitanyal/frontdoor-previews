---
/**
 * Practice utility/legal footer, mobile appointment/phone actions, and email-copy toast.
 * providerPage uses provider action labels/phone; utilities always lead to public content.
 * practiceRoot adjusts legal and mobile contact links for nested routes.
 * config.footer.frontdoorCredit enables the shared website attribution.
 * Fictional demos use one mobile consultation-section link and omit the phone action.
 * Reflective pages hide the mobile bar while their main consultation actions are visible.
 */
import { HOME_SECTION_IDS, homeSectionNavigation } from '../../lib/home-sections.mjs';

interface Props {
  config: Record<string, any>;
  phoneHref?: string;
  providerLabels?: Record<string, string>;
  providerPage?: boolean;
  practiceRoot?: string;
}

const {
  config,
  phoneHref = config.practice.phoneHref,
  providerLabels = {},
  providerPage = false,
  practiceRoot = './',
} = Astro.props;
const { hero, practice } = config;
const currentYear = new Date().getFullYear();
const patientLinks = homeSectionNavigation(config)
  .filter((section) => ['providers', 'treatments', 'resources', 'location', 'contact'].includes(section.key))
  .map((section) => ({
    label: section.key === 'contact' ? 'Appointments & contact' : section.label,
    href: section.pagePath ? `${practiceRoot}${section.pagePath}` : `${practiceRoot}#${section.id}`,
  }));
---

    <footer class="practice-footer border-t border-white/60 bg-warm-200 px-6 py-8 lg:px-8">
      {patientLinks.length >= 3 && (
        <nav class="practice-footer-tools section-shell" aria-label="Patient information">
          <p class="practice-footer-heading">Patient information</p>
          <ul>{patientLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </nav>
      )}
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-sm text-slate-500 md:flex-row">
        <div class="text-center md:text-left">
          <p>© {currentYear} {practice.name}</p>
          {config.footer?.frontdoorCredit && (
            <p class="mt-2">Website by <a class="underline underline-offset-4 transition hover:text-slate-950" href="https://frontdoor.health/">frontdoor.health</a></p>
          )}
        </div>
        <nav
          class="practice-footer-legal flex flex-wrap justify-center gap-x-6 gap-y-1"
          aria-label="Legal navigation"
        >
          <a class="transition hover:text-slate-950" href={`${practiceRoot}privacy/`}>Privacy</a>
          <a class="transition hover:text-slate-950" href={`${practiceRoot}terms/`}>Terms</a>
          <a class="transition hover:text-slate-950" href={`${practiceRoot}accessibility/`}>
            Accessibility
          </a>
        </nav>
      </div>
    </footer>
<div
  class="practice-mobile-actions fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white p-3 md:hidden"
>
  <div class:list={['mx-auto grid max-w-md gap-3', config.fictionalDemo ? 'grid-cols-1' : 'grid-cols-2']}>
    <a
      href={providerPage ? '#appointment' : `${practiceRoot === './' ? '' : practiceRoot}#${HOME_SECTION_IDS.contact}`}
      class="btn-primary min-h-[44px] px-3 py-2 text-sm"
    >
      {
        providerPage
          ? providerLabels.bookAppointment || 'Book Appointment'
          : hero.primaryCta
      }
    </a>
    {!config.fictionalDemo && <a
      href={phoneHref}
      data-frontdoor-cta="phone"
      class="btn-secondary min-h-[44px] px-3 py-2 text-sm"
    >
      {providerPage ? providerLabels.callOffice || 'Call Office' : 'Call Office'}
    </a>}
  </div>
</div>
{config.designVariant === 'reflective' && (
  <script is:inline>
    (() => {
      const bar = document.querySelector('.practice-mobile-actions');
      const actions = document.querySelector('.home-hero-actions, .provider-actions');
      if (!bar || !actions || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(([entry]) => {
        bar.hidden = entry.isIntersecting;
      }, { rootMargin: '0px 0px -80px 0px' }).observe(actions);
    })();
  </script>
)}
<div
  data-copy-toast
  class="pointer-events-none fixed inset-x-4 bottom-24 z-[60] mx-auto hidden max-w-sm rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-950 shadow-lg md:bottom-6"
  role="status"
  aria-live="polite"
>
  {providerPage ? 'Email copied' : '✓ Email copied'}
</div>
