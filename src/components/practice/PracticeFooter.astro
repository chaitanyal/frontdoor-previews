---
/**
 * Practice legal footer, mobile appointment/phone actions, and email-copy toast.
 * providerPage omits the homepage legal footer and uses provider action labels/phone.
 * practiceRoot adjusts legal and mobile contact links for nested routes.
 * config.footer.frontdoorCredit enables the shared website attribution.
 */
import { HOME_SECTION_IDS } from '../../lib/home-sections.mjs';

interface Props {
  config: Record<string, any>;
  phoneHref?: string;
  providerLabels?: Record<string, string>;
  providerPage?: boolean;
  practiceRoot?: string;
}

const {
  config,
  phoneHref = config.practice.phoneHref,
  providerLabels = {},
  providerPage = false,
  practiceRoot = './',
} = Astro.props;
const { hero, practice } = config;
const currentYear = new Date().getFullYear();
---

{
  !providerPage && (
    <footer class="practice-footer border-t border-white/60 bg-warm-200 px-6 py-8 lg:px-8">
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-sm text-slate-500 md:flex-row">
        <div class="text-center md:text-left">
          <p>© {currentYear} {practice.name}</p>
          {config.footer?.frontdoorCredit && (
            <p class="mt-2">Website by <a class="underline underline-offset-4 transition hover:text-slate-950" href="https://frontdoor.health/">frontdoor.health</a></p>
          )}
        </div>
        <nav
          class="flex justify-center gap-8"
          aria-label="Legal navigation"
        >
          <a class="transition hover:text-slate-950" href={`${practiceRoot}privacy/`}>Privacy</a>
          <a class="transition hover:text-slate-950" href={`${practiceRoot}terms/`}>Terms</a>
          <a class="transition hover:text-slate-950" href={`${practiceRoot}accessibility/`}>
            Accessibility
          </a>
        </nav>
      </div>
    </footer>
  )
}
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white p-3 md:hidden"
>
  <div class="mx-auto grid max-w-md grid-cols-2 gap-3">
    <a
      href={providerPage ? '#appointment' : `${practiceRoot === './' ? '' : practiceRoot}#${HOME_SECTION_IDS.contact}`}
      class="btn-primary min-h-[44px] px-3 py-2 text-sm"
    >
      {
        providerPage
          ? providerLabels.bookAppointment || 'Book Appointment'
          : hero.primaryCta
      }
    </a>
    <a
      href={phoneHref}
      data-frontdoor-cta="phone"
      class="btn-secondary min-h-[44px] px-3 py-2 text-sm"
    >
      {providerPage ? providerLabels.callOffice || 'Call Office' : 'Call Office'}
    </a>
  </div>
</div>
<div
  data-copy-toast
  class="pointer-events-none fixed inset-x-4 bottom-24 z-[60] mx-auto hidden max-w-sm rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-950 shadow-lg md:bottom-6"
  role="status"
  aria-live="polite"
>
  {providerPage ? 'Email copied' : '✓ Email copied'}
</div>
