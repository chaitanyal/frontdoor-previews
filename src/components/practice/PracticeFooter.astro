---
import {
  HOME_SECTION_IDS,
  homeSectionNavigation,
} from '../../lib/home-sections.mjs';

interface Props {
  config: Record<string, any>;
  phoneHref?: string;
  providerLabels?: Record<string, string>;
  providerPage?: boolean;
}

const {
  config,
  phoneHref = config.practice.phoneHref,
  providerLabels = {},
  providerPage = false,
} = Astro.props;
const { hero } = config;
const homeSections = homeSectionNavigation(config);
---

{
  !providerPage && (
    <footer class="border-t border-white/60 bg-warm-200 px-6 py-10 lg:px-8">
      <div class="mx-auto max-w-7xl space-y-6">
        <nav
          class="flex flex-wrap justify-center gap-x-7 gap-y-3 text-sm font-medium text-slate-600"
          aria-label="Practice sections"
        >
          {homeSections.map((section) => (
            <a
              class="transition hover:text-slate-950"
              href={`#${section.id}`}
              data-home-section-link={section.id}
            >
              {section.label}
            </a>
          ))}
        </nav>
        <nav
          class="flex justify-center gap-8 border-t border-slate-300/60 pt-5 text-sm text-slate-500"
          aria-label="Legal navigation"
        >
          <a class="transition hover:text-slate-950" href="./privacy/">Privacy</a>
          <a class="transition hover:text-slate-950" href="./accessibility/">
            Accessibility
          </a>
        </nav>
      </div>
    </footer>
  )
}
<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white p-3 md:hidden"
>
  <div class="mx-auto grid max-w-md grid-cols-2 gap-3">
    <a
      href={providerPage ? '#appointment' : `#${HOME_SECTION_IDS.contact}`}
      class="btn-primary min-h-[44px] px-3 py-2 text-sm"
    >
      {
        providerPage
          ? providerLabels.bookAppointment || 'Book Appointment'
          : hero.primaryCta
      }
    </a>
    <a
      href={phoneHref}
      data-frontdoor-cta="phone"
      class="btn-secondary min-h-[44px] px-3 py-2 text-sm"
    >
      {providerPage ? providerLabels.callOffice || 'Call Office' : 'Call Office'}
    </a>
  </div>
</div>
<div
  data-copy-toast
  class="pointer-events-none fixed inset-x-4 bottom-24 z-[60] mx-auto hidden max-w-sm rounded-2xl border border-slate-200 bg-white px-4 py-3 text-center text-sm font-semibold text-slate-950 shadow-lg md:bottom-6"
  role="status"
  aria-live="polite"
>
  {providerPage ? 'Email copied' : '✓ Email copied'}
</div>
