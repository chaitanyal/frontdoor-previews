---
/** Optional core-care overview; config separates regular services from advanced treatments. */
import { HOME_SECTION_IDS } from '../../lib/home-sections.mjs';
interface Props { config: Record<string, any>; }
const { config } = Astro.props;
const content = config.careOptions;
---

{content && (
  <section id={HOME_SECTION_IDS.careOptions} class="home-care-options section scroll-mt-24 border-t border-slate-200 bg-white" aria-labelledby="care-options-title">
    <div class="section-shell">
      <div class="max-w-3xl">
        <p class="eyebrow">Ways we can help</p>
        <h2 id="care-options-title" class="section-title">{content.heading}</h2>
        <p data-section-summary class="section-copy">{content.summary}</p>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2">
        {content.items.map((item) => (
          <article class="border-t border-slate-200 pt-5">
            <h3 class="font-serif text-2xl font-semibold tracking-tight">{item.heading}</h3>
            <p class="section-copy mt-4">{item.summary}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}
