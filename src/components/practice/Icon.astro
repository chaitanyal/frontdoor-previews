---
/**
 * Decorative Lucide placeholder; name selects the icon and class controls sizing.
 * Requires the containing page to load Lucide and call createIcons().
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

<i data-lucide={name} class={className} aria-hidden="true"></i>
