---
/** Shared native provider link: compact comparison card or the existing introduction. */
import { practiceAssetUrl } from '../../lib/assets.mjs';
import Icon from './Icon.astro';
interface Props {
  provider: Record<string, any>;
  config: Record<string, any>;
  isSingleProvider?: boolean;
  compact?: boolean;
  practiceRoot?: string;
  directory?: boolean;
}
const { provider, config, isSingleProvider = false, compact = false, practiceRoot = './', directory = false } = Astro.props;
const Heading = directory ? 'h2' : 'h3';
---
{compact ? (
<a class="provider-card provider-card--compact" href={`${practiceRoot}providers/${provider.slug}/`} aria-label={`View profile for ${provider.name}`}>
  <div class="provider-card-portrait">
    <img loading="lazy" src={practiceAssetUrl(provider.image, practiceRoot === '../' ? 1 : 0)} alt={provider.imageAlt} width="240" height="240" class="image-treatment" />
  </div>
  <div class="provider-card-identity">
    <Heading class="provider-card-name">{provider.name}</Heading>
    {provider.credentials && <p class="provider-card-credentials">{provider.credentials}</p>}
    {provider.specialty && <p class="provider-card-role">{provider.specialty}</p>}
    <span class="provider-card-link" aria-hidden="true">View profile <Icon name="ArrowRight" class="h-4 w-4" /></span>
  </div>
</a>
) : (
<a
  class={`home-provider-card fade-in-up soft-card interactive-card flex cursor-pointer flex-col p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-xl active:scale-[0.995] focus:outline-none focus-visible:ring-4 focus-visible:ring-slate-300 ${
    isSingleProvider
      ? 'md:grid md:grid-cols-[14rem_minmax(0,1fr)] md:gap-x-8 md:gap-y-5 md:p-8'
      : 'md:p-6'
  }`}
  href={`${practiceRoot}providers/${provider.slug}/`}
  aria-label={`View profile for ${provider.name}`}
>
  <div
    class={`home-provider-intro flex items-start gap-4 ${isSingleProvider ? 'md:contents' : ''}`}
  >
    <div
      class={`home-provider-image h-32 w-28 shrink-0 overflow-hidden rounded-2xl sm:h-36 sm:w-32 ${
        isSingleProvider
          ? 'md:col-start-1 md:row-span-3 md:h-72 md:w-56 md:rounded-[24px]'
          : ''
      }`}
    >
      <img
        loading="lazy"
        src={practiceAssetUrl(provider.image, practiceRoot === '../' ? 1 : 0)}
        alt={provider.imageAlt}
        class="image-treatment h-full w-full object-cover object-top"
      />
    </div>
    <div
      class={`home-provider-meta min-w-0 pt-1 ${isSingleProvider ? 'md:col-start-2' : ''}`}
    >
      <h3
        class={`text-xl font-semibold leading-tight text-slate-950 ${
          isSingleProvider ? 'md:text-2xl' : ''
        }`}
      >
        {provider.name}
      </h3>
      {
        config.theme !== 'structured-clinical' && provider.credentials && (
          <p class="mt-1 text-sm leading-6 text-slate-500">
            {provider.credentials}
          </p>
        )
      }
      <span
        class={`mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-primary ${
          isSingleProvider ? 'md:text-base' : ''
        }`}
        aria-hidden="true"
      >
        View profile
        <Icon name="ArrowRight" class="h-4 w-4" />
      </span>
    </div>
  </div>
  <p
    class={`home-provider-tagline mt-5 text-base leading-7 text-slate-700 ${
      isSingleProvider
        ? 'md:col-start-2 md:mt-0 md:text-lg md:leading-8'
        : ''
    }`}
  >
    {provider.tagline || ''}
  </p>
  <div
    class={`home-provider-tags mt-4 flex flex-wrap gap-2 ${
      isSingleProvider ? 'md:col-start-2 md:mt-0' : ''
    }`}
  >
    {(provider.heroTrustItems || provider.specialties || [])
      .slice(0, 2)
      .map((item) => (
        <span class="badge-brand max-w-full">
          <Icon name="CheckCircle" class="h-3.5 w-3.5 shrink-0" />
          {item}
        </span>
      ))}
  </div>
</a>
)}
