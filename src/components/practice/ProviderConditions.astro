---
import { homeContent } from '../../lib/practice-view.mjs';
import { HOME_SECTION_IDS } from '../../lib/home-sections.mjs';
import Icon from './Icon.astro';

interface Props {
  config: Record<string, any>;
}

const { config } = Astro.props;
const { providers = [], conditions = [], conditionsIntro = '' } = config;
const content = homeContent(config);
const isSingleProvider = providers.length === 1;
---

{
  providers.length > 0 && (
    <section
      id={HOME_SECTION_IDS.providers}
      class="section border-t border-slate-200/70 bg-white"
    >
      <div class="section-shell">
        <div class="max-w-2xl">
          <p class="eyebrow">{content.providerEyebrow}</p>
          <h2 class="section-title">{content.providerTitle}</h2>
          <p data-section-summary class="section-copy">{content.providerCopy}</p>
        </div>
        <div
          class={`mt-10 grid grid-cols-1 gap-6 ${
            isSingleProvider
              ? 'mx-auto max-w-3xl'
              : 'md:grid-cols-2 xl:grid-cols-3'
          }`}
        >
          {providers.map((provider) => (
            <article
              class={`fade-in-up soft-card interactive-card flex h-full cursor-pointer flex-col p-5 transition duration-200 hover:-translate-y-0.5 hover:shadow-xl active:scale-[0.995] focus:outline-none focus-visible:ring-4 focus-visible:ring-slate-300 md:p-6 ${
                isSingleProvider
                  ? 'md:grid md:grid-cols-[10rem_minmax(0,1fr)] md:gap-x-7 md:gap-y-4'
                  : ''
              }`}
              tabindex="0"
              role="link"
              data-card-href={`./providers/${provider.slug}/`}
              aria-label={`View profile for ${provider.name}`}
            >
              <div
                class={`flex items-start gap-4 ${isSingleProvider ? 'md:contents' : ''}`}
              >
                <div
                  class={`h-32 w-28 shrink-0 overflow-hidden rounded-2xl sm:h-36 sm:w-32 ${
                    isSingleProvider
                      ? 'md:col-start-1 md:row-span-3 md:h-48 md:w-40'
                      : ''
                  }`}
                >
                  <img
                    loading="lazy"
                    src={provider.image}
                    alt={provider.imageAlt}
                    class="image-treatment h-full w-full object-cover object-top"
                  />
                </div>
                <div
                  class={`min-w-0 pt-1 ${isSingleProvider ? 'md:col-start-2' : ''}`}
                >
                  <h3 class="text-xl font-semibold leading-tight text-slate-950">
                    {provider.name}
                  </h3>
                  <p class="mt-1 text-sm leading-6 text-slate-500">
                    {provider.credentials}
                  </p>
                  <span
                    class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-primary"
                    aria-hidden="true"
                  >
                    View profile
                    <Icon name="ArrowRight" class="h-4 w-4" />
                  </span>
                </div>
              </div>
              <p
                class={`mt-5 text-base leading-7 text-slate-700 ${
                  isSingleProvider ? 'md:col-start-2 md:mt-0' : ''
                }`}
              >
                {provider.tagline || ''}
              </p>
              <div
                class={`mt-4 flex flex-wrap gap-2 ${
                  isSingleProvider ? 'md:col-start-2 md:mt-0' : ''
                }`}
              >
                {(provider.heroTrustItems || provider.specialties || [])
                  .slice(0, 2)
                  .map((item) => (
                    <span class="badge-brand max-w-full">
                      <Icon name="CheckCircle" class="h-3.5 w-3.5 shrink-0" />
                      {item}
                    </span>
                  ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
<section
  id={HOME_SECTION_IDS.conditions}
  class="section relative overflow-hidden border-t border-white/60 bg-warm-50"
>
  <svg
    aria-hidden="true"
    class="conditions-leaf pointer-events-none absolute right-4 top-8 h-72 w-72 text-slate-950 opacity-[0.05] md:right-12 md:top-12"
    viewBox="0 0 220 220"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M109 188C109 133 109 76 109 32" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
    <path d="M109 82C86 58 64 47 42 49C45 74 62 91 109 102" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M110 110C139 78 164 66 190 69C186 98 165 119 110 132" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M109 145C82 120 58 109 35 113C40 140 61 158 109 166" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <div class="section-shell relative">
    <div class="max-w-3xl">
      <p class="eyebrow">Areas of care</p>
      <h2 class="section-title">Conditions We Treat</h2>
      <p data-section-summary class="section-copy">{conditionsIntro}</p>
    </div>
    <ul
      class="mt-14 grid grid-cols-1 gap-x-12 sm:grid-cols-2 lg:grid-cols-3"
      aria-label="Conditions treated"
    >
      {
        conditions.map((condition) => (
          <li class="border-t border-slate-200 py-5">
            <h3 class="text-lg font-semibold tracking-tight text-slate-950">
              {condition}
            </h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>
