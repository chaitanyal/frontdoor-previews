---
/**
 * Contact-card group receiving a contact object as practice (phone, phoneHref, email).
 * Always renders phone; email is optional. Supports compact sizing, labels,
 * and disabled cards for fictional practices.
 */
import ContactCard from './ContactCard.astro';

interface Props {
  practice: Record<string, any>;
  variant?: 'lg' | 'sm';
  disabled?: boolean;
  labels?: {
    email?: string;
    phone?: string;
  };
}

const {
  practice,
  variant = 'lg',
  disabled = false,
  labels = {},
} = Astro.props;
---

<div
  class:list={[
    'mt-5 grid gap-3',
    variant === 'sm' && practice.email && 'sm:grid-cols-2',
  ]}
>
  <ContactCard
    type="phone"
    label={labels.phone || 'Call Office'}
    value={practice.phone}
    href={practice.phoneHref}
    variant={variant}
    disabled={disabled}
  />
  {
    practice.email && (
      <ContactCard
        type="email"
        label={labels.email || 'Email'}
        value={practice.email}
        variant={variant}
        disabled={disabled}
      />
    )
  }
</div>
