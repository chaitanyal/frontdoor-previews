---
import { homeContent } from '../../lib/practice-view.mjs';
import ContactCard from './ContactCard.astro';
import Icon from './Icon.astro';

interface Props {
  config: Record<string, any>;
}

const { config } = Astro.props;
const { practice, location, faqs = [] } = config;
const content = homeContent(config);
---

<section
  id="location"
  class="section section-surface-location border-t border-white/60"
>
  <div class="section-shell">
    <div class="max-w-2xl">
      <p class="eyebrow">Visit the office</p>
      <h2 class="section-title">{location.title}</h2>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <div class="soft-card overflow-hidden">
        <div class="relative h-72 overflow-hidden">
          <img
            src={location.officeImage}
            alt={location.officeImageAlt}
            loading="lazy"
            class="image-treatment h-full w-full object-cover"
          />
          <div
            class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-slate-950/15 to-transparent"
            aria-hidden="true"
          ></div>
        </div>
        <div class="p-8">
          <h3 class="text-2xl font-semibold tracking-tight text-slate-950">
            {practice.name}
          </h3>
          <div class="mt-6 space-y-5 text-base leading-7 text-slate-600">
            <div class="flex gap-3">
              <span class="icon-chip"><Icon name="MapPin" /></span>
              <div>
                <p class="font-semibold text-slate-950">Address</p>
                {practice.addressLines.map((line) => <p>{line}</p>)}
              </div>
            </div>
            <div class="flex gap-3">
              <span class="icon-chip"><Icon name="Phone" /></span>
              <div>
                <p class="font-semibold text-slate-950">Phone</p>
                <p>{practice.phone}</p>
              </div>
            </div>
            {
              practice.email && (
                <div class="flex gap-3">
                  <span class="icon-chip"><Icon name="Mail" /></span>
                  <div>
                    <p class="font-semibold text-slate-950">Email</p>
                    <p>{practice.email}</p>
                  </div>
                </div>
              )
            }
          </div>
          <div class="mt-8 grid gap-3">
            <a
              href={location.directionsHref}
              data-frontdoor-cta="directions"
              class="btn-primary min-h-[52px] w-full"
            >
              <Icon name="MapPin" />
              Get Directions
            </a>
            <ContactCard
              type="phone"
              label="Call Office"
              value={practice.phone}
              href={practice.phoneHref}
            />
          </div>
        </div>
      </div>
      <div class="soft-card p-8">
        <div class="flex items-center justify-between gap-3">
          <h3
            class="flex items-center gap-2 whitespace-nowrap text-xl font-semibold tracking-tight text-slate-950 sm:gap-3 sm:text-2xl"
          >
            <span class="icon-chip h-9 w-9 sm:h-10 sm:w-10">
              <Icon name="Clock3" class="h-5 w-5" />
            </span>
            Office Hours
          </h3>
          <span
            class="whitespace-nowrap rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-600"
            data-office-status
            data-time-zone={location.timeZone}
            data-weekly-hours={JSON.stringify(location.weeklyHours || {})}
          >
            Hours Listed
          </span>
        </div>
        <div class="mt-8 space-y-5">
          {
            location.hours.map(([day, hours], index) => (
              <div
                class={
                  index === location.hours.length - 1
                    ? 'flex items-center justify-between'
                    : 'hours-row'
                }
              >
                <p class="text-base font-medium text-slate-700">{day}</p>
                <p class="text-base font-semibold text-slate-950">{hours}</p>
              </div>
            ))
          }
        </div>
        {
          content.telehealthNotice && (
            <div class="mt-8 rounded-[28px] border border-white/60 bg-sage-50 p-5">
              <p class="flex items-center gap-3 text-sm font-semibold text-brand-accent">
                <span class="icon-chip bg-white/80"><Icon name="Video" /></span>
                {content.telehealthNotice}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
<section id="faq" class="section border-t border-white/60 bg-warm-50">
  <div class="mx-auto max-w-4xl">
    <div class="max-w-2xl">
      <p class="eyebrow">FAQ</p>
      <h2 class="section-title">Common questions</h2>
    </div>
    <div
      class="mt-12 soft-card divide-y divide-slate-100/80 overflow-hidden"
    >
      {
        faqs.map((faq, index) => (
          <details
            class="group p-7 transition-all duration-300 hover:bg-white/70"
            open={index === 0}
          >
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between rounded-xl text-base font-semibold text-slate-950 focus:outline-none focus-visible:ring-4 focus-visible:ring-slate-300">
              {faq.question}
              <span
                class="icon-chip h-8 w-8 transition duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="mt-4 space-y-3 text-base leading-7 text-slate-600">
              {String(faq.answer || '')
                .split('\n')
                .filter(Boolean)
                .map((line) => <p>{line}</p>)}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
