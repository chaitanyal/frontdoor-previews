---
import Icon from './Icon.astro';

interface Props {
  type: 'email' | 'phone';
  label: string;
  value: string;
  href?: string;
  variant?: 'lg' | 'sm';
}

const {
  type,
  label,
  value,
  href = '',
  variant = 'lg',
} = Astro.props;
const isEmail = type === 'email';
const isCompact = variant === 'sm';
const base = 'group flex w-full min-w-0 items-center border border-slate-200 bg-white/85 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-brand-primary hover:bg-white hover:shadow-md focus:outline-none focus-visible:ring-4 focus-visible:ring-slate-300';
const size = isCompact
  ? 'min-h-[52px] gap-3 rounded-2xl px-4 py-3'
  : 'min-h-[72px] gap-4 rounded-[24px] p-4';
const iconClass = isCompact
  ? 'icon-chip h-8 w-8 shrink-0 bg-warm-50'
  : 'icon-chip shrink-0 bg-warm-50';
const labelClass = isCompact
  ? 'sr-only'
  : 'block text-sm font-semibold uppercase tracking-wide text-slate-500';
const valueClass = isCompact
  ? 'block break-words text-sm font-semibold leading-5 text-slate-700 sm:text-base'
  : `mt-1 block break-words ${
      isEmail
        ? 'text-base font-semibold text-slate-700'
        : 'text-lg font-semibold text-slate-950'
    }`;
---

{
  isEmail ? (
    <button
      type="button"
      data-copy-email={value}
      data-frontdoor-cta="email"
      class={`${base} ${size}`}
      aria-label={`Copy ${label.toLowerCase()} ${value}`}
    >
      <span class={iconClass}><Icon name="Mail" /></span>
      <span class="min-w-0">
        <span class={labelClass}>{label}</span>
        <span class={valueClass}>{value}</span>
      </span>
    </button>
  ) : (
    <a
      href={href}
      data-frontdoor-cta="phone"
      class={`${base} ${size}`}
      aria-label={`${label} ${value}`}
    >
      <span class={iconClass}><Icon name="Phone" /></span>
      <span class="min-w-0">
        <span class={labelClass}>{label}</span>
        <span class={valueClass}>{value}</span>
      </span>
    </a>
  )
}
