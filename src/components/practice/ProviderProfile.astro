---
import { practiceAssetUrl } from '../../lib/assets.mjs';
import {
  providerAffiliationMode,
  providerProfile,
} from '../../lib/practice-view.mjs';
import AppointmentSection from './AppointmentSection.astro';
import Icon from './Icon.astro';
import PracticeFooter from './PracticeFooter.astro';
import PracticeHeader from './PracticeHeader.astro';

interface Props {
  config: Record<string, any>;
  provider: Record<string, any>;
  isPreview?: boolean;
}

const { config, provider, isPreview = false } = Astro.props;
const profile = providerProfile(config, provider);
const bioLinks = Array.isArray(provider.bioLinks) ? provider.bioLinks : [];
const bioParts = (paragraph: string) => {
  const parts: Array<{ text: string; url?: string }> = [{ text: paragraph }];

  for (const link of bioLinks) {
    const matchText = String(link.text || '');
    if (!matchText) continue;

    const partIndex = parts.findIndex(
      (part) => !part.url && part.text.includes(matchText),
    );
    if (partIndex === -1) continue;

    const part = parts[partIndex];
    const matchIndex = part.text.indexOf(matchText);
    parts.splice(
      partIndex,
      1,
      ...(matchIndex > 0
        ? [{ text: part.text.slice(0, matchIndex) }]
        : []),
      { text: matchText, url: link.url },
      ...(matchIndex + matchText.length < part.text.length
        ? [{ text: part.text.slice(matchIndex + matchText.length) }]
        : []),
    );
  }

  return parts;
};
const educationRows = [
  ['Board Certification', provider.certifications],
  ['Medical School', profile.education.medicalSchool],
  ['Physician Assistant Program', profile.education.physicianAssistantProgram],
  ['Undergraduate Education', profile.education.undergraduate],
  ['Residency', profile.education.residency],
  ['Fellowship', profile.education.fellowship],
].flatMap(([label, value]) =>
  value
    ? [{ label, values: Array.isArray(value) ? value : [value] }]
    : []);
const affiliationMode = providerAffiliationMode(profile);
---

<PracticeHeader
  config={config}
  phoneHref={profile.phoneHref}
  providerLabels={profile.labels}
  providerPage
/>
<main id="main-content" tabindex="-1">
  <section class="section bg-warm-50">
    <div class="section-shell">
      <nav class="mb-8 text-sm font-medium text-slate-500" aria-label="Breadcrumb">
        <a class="hover:text-slate-950" href="../../">Home</a>
        <span class="mx-2">/</span>
        <a class="hover:text-slate-950" href="../../#providers">Providers</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800">{profile.name}</span>
      </nav>
      <div
        class="grid grid-cols-1 gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
      >
        <div class="mx-auto w-full max-w-md lg:max-w-none">
          <div
            class="aspect-[4/5] overflow-hidden rounded-[36px] border border-slate-200 bg-white"
          >
            <img
              src={practiceAssetUrl(provider.image, 2)}
              alt={provider.imageAlt}
              class="image-treatment h-full w-full object-cover object-top"
              width="720"
              height="900"
            />
          </div>
        </div>
        <div class="soft-card rounded-3xl p-8 md:p-10">
          <h1
            class="text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-6xl"
          >
            {profile.name}
          </h1>
          {
            provider.credentials && (
              <p class="mt-2 text-base font-semibold tracking-wide text-slate-500 md:text-lg">
                {provider.credentials}
              </p>
            )
          }
          {
            provider.heroTitle && (
              <p class="mt-4 text-lg font-semibold text-brand-primary">
                {provider.heroTitle}
              </p>
            )
          }
          <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">
            {provider.tagline || profile.description}
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            {
              profile.trustItems.map((item) => (
                <span class="badge-brand">
                  <Icon name="CheckCircle" class="h-3.5 w-3.5" />
                  {item}
                </span>
              ))
            }
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="#appointment" class="btn-primary">
              {profile.labels.bookAppointment}
            </a>
            <a
              href={profile.phoneHref}
              data-frontdoor-cta="phone"
              class="btn-secondary"
            >
              {profile.labels.callOffice}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-white px-6 py-12 lg:px-8 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <h2
        class="max-w-3xl text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-5xl"
      >
        {profile.aboutHeading}
      </h2>
      <div
        class="mt-7 max-w-3xl space-y-5 text-lg leading-9 text-slate-700 md:text-xl md:leading-10"
      >
        {
          profile.bioParagraphs.slice(0, 2).map((paragraph) => (
            <p>
              {bioParts(paragraph).map((part) =>
                part.url ? (
                  <a
                    class="font-semibold text-brand-primary underline decoration-brand-primary/40 underline-offset-4 hover:decoration-brand-primary"
                    href={part.url}
                  >
                    {part.text}
                  </a>
                ) : (
                  part.text
                ),
              )}
            </p>
          ))
        }
      </div>
      {
        config.providerProfileSections?.expectations !== false &&
          profile.expectations.length > 0 && (
          <div class="mt-10 max-w-3xl rounded-3xl bg-warm-50 p-6 md:p-8">
            <h3 class="text-xl font-bold tracking-tight text-slate-950 md:text-2xl">
              {profile.labels.howProviderHelps}
            </h3>
            <ul class="mt-5 space-y-4">
              {profile.expectations.map((expectation) => (
                <li class="flex gap-3 text-base leading-7 text-slate-700 md:text-lg md:leading-8">
                  <span
                    class="mt-2 h-2 w-2 shrink-0 rounded-full bg-brand-accent"
                    aria-hidden="true"
                  ></span>
                  <span>{expectation}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>
  {
    [
      [profile.labels.conditionsTreated, profile.conditions, 'bg-warm-50'],
      [profile.labels.treatmentServices, profile.services, 'bg-white'],
    ].map(([heading, values, background]) => (
      <section class={`${background} px-6 py-12 lg:px-8 lg:py-20`}>
        <div class="mx-auto max-w-6xl">
          <h2 class="text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-5xl">
            {heading}
          </h2>
          <ul class="mt-7 grid grid-cols-1 gap-3 sm:grid-cols-2 md:gap-4 lg:grid-cols-3">
            {values.map((value) => (
              <li class="flex min-h-[72px] items-center rounded-2xl border border-slate-200 bg-white p-5 text-base font-semibold leading-6 text-slate-800">
                {value}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }
  <section class="bg-warm-50 px-6 py-12 lg:px-8 lg:py-20">
    <div class="mx-auto max-w-6xl">
      <h2
        class="text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-5xl"
      >
        {profile.labels.educationTraining}
      </h2>
      <div class="mt-7 grid grid-cols-1 gap-4 md:grid-cols-2">
        {
          educationRows.length > 0 ? (
            educationRows.map((row) => (
              <div class="rounded-3xl border border-slate-200 bg-white p-6 md:p-7">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand-accent">
                  {row.label}
                </p>
                <div class="mt-3 space-y-1.5 text-base leading-7 text-slate-700">
                  {row.values.map((value) => (
                    <p>
                      {String(value)
                        .split('\n')
                        .map((line, index) => (
                          <>
                            {index > 0 && <br />}
                            {line}
                          </>
                        ))}
                    </p>
                  ))}
                </div>
              </div>
            ))
          ) : (
            <div class="soft-card rounded-3xl p-6 text-lg leading-8 text-slate-700 md:p-7">
              Please contact the office for additional training details.
            </div>
          )
        }
      </div>
    </div>
  </section>
  {
    affiliationMode && (
      <section class="bg-warm-50 px-6 py-12 lg:px-8 lg:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="soft-card rounded-3xl p-6 md:p-8">
            <h2 class="text-4xl font-bold leading-tight tracking-tight text-slate-950 md:text-5xl">
              {affiliationMode === 'hospital'
                ? profile.labels.hospitalAffiliations
                : profile.labels.professionalAffiliations}
            </h2>
            {affiliationMode === 'hospital' && (
              <p class="mt-3 text-base text-slate-600">
                {profile.labels.hospitalAffiliationsIntro}
              </p>
            )}
            <ul class="mt-7 grid grid-cols-1 gap-3 md:grid-cols-2 md:gap-4">
              {(affiliationMode === 'hospital'
                ? profile.hospitalAffiliations
                : profile.professionalCredentials
              ).map((value) => (
                <li class="flex min-h-[72px] items-center rounded-2xl border border-slate-200 bg-white p-5 text-base font-semibold leading-6 text-slate-800">
                  {value}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }
  <AppointmentSection
    appointmentUrl={profile.appointmentUrl}
    patientPortalUrl={profile.patientPortalUrl}
    phone={profile.phone}
    phoneHref={profile.phoneHref}
    email={profile.email}
    emergencyNotice={profile.emergencyNotice}
    actionLinksDisabled={
      isPreview && config.practice.disableExternalActionLinksInPreview
    }
    sectionId="appointment"
    heading={config.appointmentSection?.heading}
    summary={config.appointmentSection?.summary}
  />
</main>
<PracticeFooter
  config={config}
  phoneHref={profile.phoneHref}
  providerLabels={profile.labels}
  providerPage
/>
