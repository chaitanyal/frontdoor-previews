---
/**
 * Practice navigation and skip link from config and the shared home-section registry.
 * providerPage switches to nested-route links and provider labels/contact details.
 * homeHref lets nested pages link back to homepage sections at their route depth.
 * Directory-enabled practices link provider navigation to the full team route.
 * Expanded treatment navigation uses a wider breakpoint to avoid crowding.
 */
import {
  HOME_SECTION_IDS,
  homeSectionNavigation,
} from '../../lib/home-sections.mjs';
import { hasProviderDirectory } from '../../lib/provider-team.mjs';

interface Props {
  config: Record<string, any>;
  phoneHref?: string;
  providerLabels?: Record<string, string>;
  providerPage?: boolean;
  homeHref?: string;
}

const {
  config,
  phoneHref = config.practice.phoneHref,
  providerLabels = {},
  providerPage = false,
  homeHref = '',
} = Astro.props;
const { practice } = config;
const homeSections = homeSectionNavigation(config);
const primarySections = homeSections.filter(
  (section) => section.header && !section.cta,
);
const contactSection = homeSections.find((section) => section.cta);
const hasTreatments = Boolean(config.treatments?.length);
---

<a href="#main-content" class="skip-link">Skip to main content</a>
<header class="practice-header sticky top-0 z-50 border-b border-slate-200 bg-white/95">
  <div class="page-shell flex items-center justify-between py-3 md:py-4">
    <a
      href={providerPage ? '../../' : homeHref || '#main-content'}
      class="practice-brand flex items-center gap-3"
      aria-label={`${practice.name} home`}
    >
      <div
        class:list={[
          'practice-brand-mark flex items-center justify-center rounded-2xl bg-brand-primary font-semibold text-white shadow-sm',
          providerPage
            ? 'h-10 w-10 text-base'
            : 'h-9 w-9 text-sm md:h-10 md:w-10 md:text-base',
        ]}
      >
        {practice.name[0]}
      </div>
      <div>
        <p class="practice-brand-name text-base font-semibold text-slate-950">{practice.name}</p>
        <p class="text-xs leading-5 text-slate-500">{practice.tagline}</p>
      </div>
    </a>
    {
      providerPage ? (
        <>
          <nav
            class="hidden items-center gap-8 md:flex"
            aria-label="Provider navigation"
          >
            <a href={hasProviderDirectory(config) ? '../' : `../../#${HOME_SECTION_IDS.providers}`} class="nav-link">
              {providerLabels.providers || 'Providers'}
            </a>
            <a href={`../../#${HOME_SECTION_IDS.conditions}`} class="nav-link">
              {providerLabels.conditions || 'Conditions'}
            </a>
            <a href="#appointment" class="btn-primary px-4 py-2.5 text-sm">
              {providerLabels.bookAppointment || 'Book Appointment'}
            </a>
          </nav>
          <a
            href={phoneHref}
            data-frontdoor-cta="phone"
            class="btn-secondary min-h-[44px] px-3 py-2 text-sm md:hidden"
          >
            {providerLabels.callOffice || 'Call Office'}
          </a>
        </>
      ) : (
        <>
          <nav
            class:list={['hidden items-center gap-8', hasTreatments ? 'xl:flex' : 'md:flex']}
            aria-label="Primary navigation"
          >
            {primarySections.map((section) => (
              <a
                href={section.pagePath ? `${homeHref || './'}${section.pagePath}` : `${homeHref}#${section.id}`}
                class="nav-link"
                data-home-section-link={section.id}
              >
                {section.label}
              </a>
            ))}
            <a
              href={`${homeHref}#${contactSection.id}`}
              class="btn-primary px-4 py-2.5 text-sm"
              data-home-section-link={contactSection.id}
            >
              {contactSection.label}
            </a>
          </nav>
          <a
            href={`${homeHref}#${contactSection.id}`}
            class:list={['btn-secondary min-h-[44px] px-3 py-2 text-sm', hasTreatments ? 'xl:hidden' : 'md:hidden']}
            data-home-section-link={contactSection.id}
          >
            Contact
          </a>
        </>
      )
    }
  </div>
</header>
