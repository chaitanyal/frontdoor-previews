---
interface Props {
  config: Record<string, any>;
  page: 'accessibility' | 'privacy' | 'terms';
}

const { config, page } = Astro.props;
const practice = config.practice || {};
const privacy = page === 'privacy';
const terms = page === 'terms';
const usesGoogleMaps = Boolean(config.location?.googleReviewSummary);
const title = privacy ? 'Privacy' : terms ? 'Terms of Use' : 'Accessibility';
---

<main class="section min-h-screen bg-warm-50">
  <div class="section-shell max-w-3xl">
    <p class="eyebrow">{title}</p>
    <h1 class="section-title">{title}</h1>
    <div class="soft-card mt-10 space-y-8 p-8 md:p-10">
      <section class="space-y-4 text-base leading-7 text-slate-600">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-950">
          {practice.name}
        </h2>
        {
          terms ? (
            <>
              <p>
                This website provides general information about the practice.
                It does not provide medical advice, diagnosis, or treatment and
                is not a substitute for care from a qualified clinician.
              </p>
              <p>
                Do not use this website for emergencies. Call 911 or go to the
                nearest emergency room when immediate medical attention is
                needed.
              </p>
              <p>
                Links to appointment, patient portal, mapping, and other
                third-party services are provided for convenience. Those
                services operate under their own terms and privacy policies.
              </p>
              {
                usesGoogleMaps && (
                  <p>
                    Google Maps features are provided subject to the{' '}
                    <a
                      class="font-semibold text-brand-primary underline underline-offset-4"
                      href="https://maps.google.com/help/terms_maps/"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Google Maps/Google Earth Additional Terms of Service
                    </a>{' '}
                    and the{' '}
                    <a
                      class="font-semibold text-brand-primary underline underline-offset-4"
                      href="https://policies.google.com/privacy"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Google Privacy Policy
                    </a>.
                  </p>
                )
              }
              {
                usesGoogleMaps && (
                  <p>
                    Google does not verify individual reviews, but it checks for
                    and removes fake content when identified. Learn more in the{' '}
                    <a
                      class="font-semibold text-brand-primary underline underline-offset-4"
                      href="https://support.google.com/contributionpolicy/answer/7422880"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Google Maps user-generated content policy
                    </a>.
                  </p>
                )
              }
            </>
          ) : privacy ? (
            <>
              <p>
                This website provides general information about the practice and
                may include contact information, office details, provider
                information, and links to third-party appointment or patient
                portal systems.
              </p>
              <p>
                Appointment requests and patient portal activity may be handled
                by third-party systems. Please avoid sending medical information
                by email or through unsecured communication channels.
              </p>
              {
                usesGoogleMaps && (
                  <p>
                    When the office section approaches your screen, this site
                    may request the practice’s current public rating from Google
                    Maps through a FrontDoor Health service. The feature does not
                    send appointment details, form contents, or review text, and
                    the rating is not stored by this website. Google’s handling
                    of data is described in the{' '}
                    <a
                      class="font-semibold text-brand-primary underline underline-offset-4"
                      href="https://policies.google.com/privacy"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Google Privacy Policy
                    </a>.
                  </p>
                )
              }
              <p>
                If you have questions about privacy or how to contact the office,
                please use the contact information below.
              </p>
            </>
          ) : (
            <>
              <p>
                The practice is committed to providing an accessible website
                experience for patients, families, and visitors.
              </p>
              <p>
                If you experience difficulty accessing information on this
                website, please contact the office so the team can assist you.
              </p>
              <p>
                This website may be updated over time as accessibility,
                usability, and content improvements are made.
              </p>
            </>
          )
        }
      </section>
      <section class="border-t border-slate-200 pt-8">
        <h2 class="text-2xl font-semibold tracking-tight text-slate-950">
          Contact Information
        </h2>
        <div class="mt-4 space-y-2 text-base leading-7 text-slate-600">
          <p>
            <span class="font-semibold text-slate-950">Phone:</span>
            {practice.phone}
          </p>
          <p>
            <span class="font-semibold text-slate-950">Email:</span>
            {practice.email}
          </p>
        </div>
      </section>
    </div>
  </div>
</main>
<footer class="border-t border-white/60 bg-warm-200 px-6 py-10 lg:px-8">
  <nav
    class="mx-auto flex max-w-7xl justify-center gap-8 text-sm font-medium text-slate-600"
    aria-label="Footer navigation"
  >
    <a class="transition hover:text-slate-950" href="../privacy/">Privacy</a>
    <a class="transition hover:text-slate-950" href="../terms/">Terms</a>
    <a class="transition hover:text-slate-950" href="../accessibility/">
      Accessibility
    </a>
  </nav>
</footer>
