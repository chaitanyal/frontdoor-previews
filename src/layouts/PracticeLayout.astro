---
import {
  robotsMeta,
  safeJsonLd,
  socialMetadata,
  webPageSchema,
} from '../lib/seo.mjs';
import { themeCssProperties } from '../lib/themes.mjs';

interface Props {
  bodyClass?: string;
  config: Record<string, any>;
  jsonLd?: object | object[];
  pageKind: 'accessibility' | 'home' | 'privacy' | 'provider' | 'terms';
  pagePath?: string;
  socialType?: string;
  stylesheetHref: string;
  theme: Record<string, string>;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const {
  bodyClass = 'bg-surface font-sans text-slate-950 antialiased',
  config,
  description,
  image,
  imageAlt,
  jsonLd,
  pageKind,
  pagePath = '',
  socialType = 'website',
  stylesheetHref,
  theme,
  title,
} = Astro.props;
const social = socialMetadata(config, {
  description,
  image,
  imageAlt,
  pagePath,
  title,
  type: socialType,
});
const robots = robotsMeta(config);
const tracksPractice = pageKind === 'home' || pageKind === 'provider';
const practiceSlugScript =
  `window.FRONTDOOR_PRACTICE_SLUG = ${JSON.stringify(config.practice.slug)};`;
const entityBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const mainEntityId = entityBlocks.find((block) => block?.['@id'])?.['@id'] || '';
const jsonLdBlocks = tracksPractice
  ? [webPageSchema(social, mainEntityId), ...entityBlocks]
  : entityBlocks;
---

<!doctype html>
<html
  lang="en"
  data-theme={config.theme}
  data-design-variant={config.designVariant || undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{social.title}</title>
    <meta name="description" content={social.description} />
    {robots && <meta name="robots" content={robots} />}
    {social.canonical && <link rel="canonical" href={social.canonical} />}
    {
      tracksPractice && (
        <>
          <meta property="og:title" content={social.title} />
          <meta property="og:type" content={social.type} />
          <meta property="og:description" content={social.description} />
          {social.canonical && (
            <meta property="og:url" content={social.canonical} />
          )}
          <meta property="og:site_name" content={social.siteName} />
          <meta property="og:locale" content={social.locale} />
          {social.image && <meta property="og:image" content={social.image} />}
          {social.image && (
            <meta property="og:image:alt" content={social.imageAlt} />
          )}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={social.title} />
          <meta name="twitter:description" content={social.description} />
          {social.image && <meta name="twitter:image" content={social.image} />}
          {social.image && (
            <meta name="twitter:image:alt" content={social.imageAlt} />
          )}
        </>
      )
    }
    <link rel="stylesheet" href={stylesheetHref} />
    {tracksPractice && <script is:inline set:html={practiceSlugScript}></script>}
    <script is:inline src="/shared/attribution.js"></script>
    {tracksPractice && <script is:inline src="/shared/analytics.js"></script>}
    {tracksPractice && <script is:inline src="https://unpkg.com/lucide@latest"></script>}
    <style is:inline set:html={`:root{${themeCssProperties(theme)}}`}></style>
    <slot name="head" />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={safeJsonLd(block)} />
    ))}
  </head>
  <body class={bodyClass}>
    <slot />
    <slot name="scripts" />
  </body>
</html>
