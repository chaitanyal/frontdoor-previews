---
import { safeJsonLd } from '../lib/seo.mjs';

interface Props {
  canonical: string;
  description: string;
  googleAds?: boolean;
  image?: string;
  imageAlt?: string;
  jsonLd?: object | object[];
  title: string;
}

const {
  canonical,
  description,
  googleAds = false,
  image,
  jsonLd,
  title,
  imageAlt = title,
} = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const googleAdsInit = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'AW-18297020270');
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="FrontDoor Health" />
    <meta property="og:locale" content="en_US" />
    {image && <meta property="og:image" content={image} />}
    {image && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && <meta name="twitter:image:alt" content={imageAlt} />}
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={safeJsonLd(block)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script is:inline src="/shared/attribution.js"></script>
    {googleAds && (
      <>
        <script
          async
          is:inline
          src="https://www.googletagmanager.com/gtag/js?id=AW-18297020270"
        ></script>
        <script is:inline set:html={googleAdsInit}></script>
        <script is:inline src="/shared/google-ads.js"></script>
      </>
    )}
    <slot name="scripts" />
  </body>
</html>
