---
/**
 * Marketing document shell with metadata, JSON-LD, compiled marketing CSS, and shared scripts.
 * assetPrefix handles route depth; feature flags enable Lucide, Turnstile, and
 * conversion support. Supplies shared skip navigation, anchor offsets, and motion safeguards.
 * Slots: default body, head additions, and page scripts.
 */
import { safeJsonLd } from '../lib/seo.mjs';

interface Props {
  assetPrefix?: string;
  bodyClass?: string;
  canonical?: string;
  description: string;
  includeGoogleAdsConversion?: boolean;
  includeLucide?: boolean;
  includeTurnstile?: boolean;
  image?: string;
  imageAlt?: string;
  jsonLd?: object | object[];
  locale?: string;
  robots?: string;
  social?: boolean;
  siteName?: string;
  title: string;
}

const {
  assetPrefix = '.',
  bodyClass = '',
  canonical,
  description,
  includeGoogleAdsConversion = false,
  includeLucide = false,
  includeTurnstile = false,
  image,
  jsonLd,
  locale = 'en_US',
  robots,
  social = true,
  siteName = 'FrontDoor Health',
  title,
  imageAlt = title,
} = Astro.props;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const googleAdsInit = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'AW-18297020270');
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {social && canonical && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:type" content="website" />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:locale" content={locale} />
        {image && <meta property="og:image" content={image} />}
        {image && <meta property="og:image:alt" content={imageAlt} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {image && <meta name="twitter:image" content={image} />}
        {image && <meta name="twitter:image:alt" content={imageAlt} />}
      </>
    )}
    <link rel="icon" href={`${assetPrefix}/assets/frontdoor-health-favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${assetPrefix}/assets/fonts/inter-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`${assetPrefix}/assets/marketing.css`} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    {includeLucide && <link rel="preconnect" href="https://unpkg.com" />}
    {includeTurnstile && <link rel="preconnect" href="https://challenges.cloudflare.com" />}
    <style is:inline>
      :where(main, section, h1, h2, h3, input, select, textarea)[id] { scroll-margin-top: 7rem; }
      .skip-link { position: absolute; top: 1rem; left: 1rem; z-index: 100; transform: translateY(-200%); padding: 0.75rem 1rem; background: #fff; color: #1E3A5F; }
      .skip-link:focus-visible { transform: none; }
      a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid #1E3A5F; outline-offset: 3px; }
      .request-spinner { display: none; width: 1em; height: 1em; margin-right: 0.5rem; vertical-align: -0.125em; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: request-spin 0.8s linear infinite; }
      [aria-busy='true'] .request-spinner { display: inline-block; }
      @keyframes request-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
        a:hover, .group:hover .group-hover\:translate-x-1 { transform: none !important; }
      }
    </style>
    <slot name="head" />
    {includeLucide && <script is:inline src="https://unpkg.com/lucide@latest"></script>}
    {includeTurnstile && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      ></script>
    )}
    <script is:inline src="/shared/attribution.js"></script>
    {includeGoogleAdsConversion && (
      <script is:inline src="/shared/google-ads.js"></script>
    )}
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={safeJsonLd(block)} />
    ))}
    <script
      async
      is:inline
      src="https://www.googletagmanager.com/gtag/js?id=AW-18297020270"
    ></script>
    <script is:inline set:html={googleAdsInit}></script>
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
    <slot name="scripts" />
  </body>
</html>
