---
import ProviderDirectoryPage from '../../../../../../pages/shared/ProviderDirectoryPage.astro';
import { loadPracticeData } from '../../../../../../lib/practice-data.mjs';
import { previewProviderDirectoryPaths } from '../../../../../../lib/preview-paths.mjs';
export async function getStaticPaths() { return previewProviderDirectoryPaths(process.cwd()); }
const { practice } = Astro.props;
const { config, theme } = await loadPracticeData(process.cwd(), practice);
---

<ProviderDirectoryPage config={config} theme={theme} />
