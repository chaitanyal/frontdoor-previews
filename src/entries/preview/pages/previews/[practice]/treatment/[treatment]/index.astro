---
import TreatmentPage from '../../../../../../../pages/shared/TreatmentPage.astro';
import { loadPracticeData } from '../../../../../../../lib/practice-data.mjs';
import { previewTreatmentPaths } from '../../../../../../../lib/preview-paths.mjs';

export async function getStaticPaths() {
  return previewTreatmentPaths(process.cwd());
}

const { practice, treatment } = Astro.props;
const { config, theme } = await loadPracticeData(process.cwd(), practice);
---

<TreatmentPage config={config} treatment={treatment} theme={theme} />
