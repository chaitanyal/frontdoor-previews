---
import FeaturedPracticeHero from '../../../components/marketing/FeaturedPracticeHero.astro';
import FeaturedResults from '../../../components/marketing/FeaturedResults.astro';
import HomeHeader from '../../../components/marketing/HomeHeader.astro';
import MarketingFooter from '../../../components/marketing/MarketingFooter.astro';
import PreviewRequestForm from '../../../components/marketing/PreviewRequestForm.astro';
import MarketingLayout from '../../../layouts/MarketingLayout.astro';
import {
  loadMarketingData,
  marketingCanonical,
  marketingHomeJsonLd,
  marketingSocialImage,
} from '../../../lib/marketing-data.mjs';

const { marketing, featured } = await loadMarketingData(process.cwd());
const title = 'FrontDoor Health | Modern websites for independent healthcare practices';
const description = 'FrontDoor Health helps independent healthcare practices create modern websites that better reflect the quality of care they already provide.';
---

<MarketingLayout
  assetPrefix="."
  bodyClass="bg-warm-50 font-sans text-slate-950 antialiased"
  canonical={marketingCanonical(marketing)}
  description={description}
  image={marketingSocialImage(marketing)}
  imageAlt={marketing.seo.ogImageAlt}
  includeGoogleAdsConversion
  includeLucide
  includeTurnstile
  jsonLd={marketingHomeJsonLd(marketing, description)}
  locale={marketing.seo.locale}
  siteName={marketing.seo.siteName}
  tailwindConfig="inline"
  title={title}
>
  <style is:inline slot="head">
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url('./assets/fonts/inter-latin.woff2') format('woff2');
    }
  </style>

  <HomeHeader />

  <main>
    <FeaturedPracticeHero {featured} />

    <section id="what" class="bg-brand-900 px-5 py-16 text-white lg:px-8 lg:py-24" aria-labelledby="patient-questions-title">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
          <div class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-blue-200">The patient decision starts online</p>
            <h2 id="patient-questions-title" class="mt-5 text-3xl font-bold leading-tight tracking-tight md:text-5xl lg:text-6xl">
              Your website should answer questions before your staff has to.
            </h2>
          </div>
          <p class="max-w-2xl text-lg leading-8 text-slate-300 lg:pb-1">
            Patients arrive with practical questions about fit, care, insurance, and scheduling. A clear website helps them find answers and move forward with confidence.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 overflow-hidden rounded-[28px] border border-white/15 bg-white/[0.04] sm:grid-cols-2 lg:grid-cols-4">
          <article class="border-b border-white/10 p-6 sm:border-r lg:border-b-0 lg:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-blue-100" aria-hidden="true">
              <i data-lucide="user-round-search" class="h-5 w-5"></i>
            </span>
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-blue-200">Patient fit</p>
            <h3 class="mt-3 text-xl font-bold leading-7 tracking-tight">Is this the right practice for me?</h3>
            <p class="mt-3 text-base leading-7 text-slate-300">Make the provider, specialty, and care philosophy easy to understand.</p>
          </article>

          <article class="border-b border-white/10 p-6 lg:border-b-0 lg:border-r lg:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-blue-100" aria-hidden="true">
              <i data-lucide="stethoscope" class="h-5 w-5"></i>
            </span>
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-blue-200">Care offered</p>
            <h3 class="mt-3 text-xl font-bold leading-7 tracking-tight">Do you treat my condition?</h3>
            <p class="mt-3 text-base leading-7 text-slate-300">Organize conditions and services around the questions patients bring.</p>
          </article>

          <article class="border-b border-white/10 p-6 sm:border-b-0 sm:border-r lg:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-blue-100" aria-hidden="true">
              <i data-lucide="shield-check" class="h-5 w-5"></i>
            </span>
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-blue-200">Coverage</p>
            <h3 class="mt-3 text-xl font-bold leading-7 tracking-tight">Do you accept my insurance?</h3>
            <p class="mt-3 text-base leading-7 text-slate-300">Put insurance, payment, and verification guidance within reach.</p>
          </article>

          <article class="p-6 lg:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-blue-100" aria-hidden="true">
              <i data-lucide="calendar-check-2" class="h-5 w-5"></i>
            </span>
            <p class="mt-6 text-xs font-semibold uppercase tracking-[0.14em] text-blue-200">Next step</p>
            <h3 class="mt-3 text-xl font-bold leading-7 tracking-tight">How do I schedule or get in touch?</h3>
            <p class="mt-3 text-base leading-7 text-slate-300">Make appointment, phone, location, and portal actions unmistakable.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="solution" class="border-b border-slate-200/70 bg-white px-5 py-16 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-8 lg:grid-cols-[1fr_0.8fr] lg:items-end">
          <div class="max-w-4xl">
            <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">What FrontDoor Health does</p>
            <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight md:text-5xl">
              Make the quality of your care visible online.
            </h2>
          </div>
          <p class="max-w-2xl text-lg leading-8 text-slate-600 lg:pb-1">
            We turn the information patients are looking for into a clear, credible website experience built around your practice.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 border-t border-slate-200 pt-8 md:grid-cols-3 md:gap-8">
          <article>
            <p class="text-sm font-bold text-sage-700">01</p>
            <h3 class="mt-4 text-xl font-bold tracking-tight">Clarify patient fit.</h3>
            <p class="mt-3 text-base leading-7 text-slate-600">Show your expertise, approach, and clinical focus before the first phone call.</p>
          </article>
          <article>
            <p class="text-sm font-bold text-sage-700">02</p>
            <h3 class="mt-4 text-xl font-bold tracking-tight">Put answers within reach.</h3>
            <p class="mt-3 text-base leading-7 text-slate-600">Make providers, services, insurance, office details, and patient resources easy to find.</p>
          </article>
          <article>
            <p class="text-sm font-bold text-sage-700">03</p>
            <h3 class="mt-4 text-xl font-bold tracking-tight">Make the next step obvious.</h3>
            <p class="mt-3 text-base leading-7 text-slate-600">Turn online searches into confident calls, directions, portal visits, and appointment requests.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-brand-50 px-5 py-16 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-4xl">
          <div>
            <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">How it works</p>
            <h2 class="mt-5 text-3xl font-bold leading-tight tracking-tight md:text-5xl">A better website without another project to manage.</h2>
          </div>
          <p class="mt-6 text-lg leading-8 text-slate-600">
            We handle the copy, design, and launch so you can stay focused on patient care.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
          <div class="rounded-[28px] bg-white/85 p-8 shadow-[0_12px_45px_rgba(15,23,42,0.06)] lg:p-9">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-lg font-bold text-brand-700">1</div>
              <h3 class="text-xl font-bold tracking-tight leading-tight">The Practice Preview</h3>
            </div>
            <p class="mt-5 text-base leading-7 text-slate-600">
              Review a personalized preview before making any commitment.
            </p>
          </div>
          <div class="rounded-[28px] bg-white/85 p-8 shadow-[0_12px_45px_rgba(15,23,42,0.06)] lg:p-9">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-lg font-bold text-brand-700">2</div>
              <h3 class="text-xl font-bold tracking-tight leading-tight">Simplified Onboarding</h3>
            </div>
            <p class="mt-5 text-base leading-7 text-slate-600">
              A short conversation. We handle the rest.
            </p>
          </div>
          <div class="rounded-[28px] bg-white/85 p-8 shadow-[0_12px_45px_rgba(15,23,42,0.06)] lg:p-9">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-lg font-bold text-brand-700">3</div>
              <h3 class="text-xl font-bold tracking-tight leading-tight">Launch With Confidence</h3>
            </div>
            <p class="mt-5 text-base leading-7 text-slate-600">
              A modern website, ready for patients.
            </p>
          </div>
        </div>
      </div>
    </section>

    <FeaturedResults {featured} />
    <PreviewRequestForm />
  </main>

  <MarketingFooter
    contactHref="#contact"
    homeHref="#"
    privacyHref="./privacy/"
  />
</MarketingLayout>
