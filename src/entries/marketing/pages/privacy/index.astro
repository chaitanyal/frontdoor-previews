---
import MarketingLayout from '../../../../layouts/MarketingLayout.astro';
import {
  loadMarketingData,
  marketingCanonical,
  marketingSocialImage,
} from '../../../../lib/marketing-data.mjs';

const { marketing } = await loadMarketingData(process.cwd());
const title = 'Privacy Policy | FrontDoor Health';
const description = 'Privacy Policy for FrontDoor Health website preview requests, analytics, cookies, and Google Ads Conversion Tracking.';
---

<MarketingLayout
  assetPrefix=".."
  bodyClass="bg-warm-50 font-sans text-slate-950 antialiased"
  canonical={marketingCanonical(marketing, 'privacy')}
  description={description}
  image={marketingSocialImage(marketing)}
  imageAlt={marketing.seo.ogImageAlt}
  tailwindConfig="inline"
  title={title}
>
  <style is:inline slot="head">
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url('../assets/fonts/inter-latin.woff2') format('woff2');
    }
  </style>
  <header class="sticky top-0 z-50 border-b border-border-100/80 bg-white/85 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
      <a href="../" class="flex flex-col items-start" aria-label="FrontDoor Health home">
        <img src="../assets/frontdoor-health-logo.svg" alt="FrontDoor Health" class="h-12 w-auto max-w-[220px] md:h-14 md:max-w-[294px]" style="height: 48px; width: auto; max-width: 220px;" />
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary navigation">
        <a href="../#what" class="text-sm font-medium text-slate-500 hover:text-slate-950">What we do</a>
        <a href="../case-studies/drdronavalli/" class="text-sm font-medium text-slate-500 hover:text-slate-950">Case Study</a>
        <a href="../#contact" class="rounded-2xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-900">Request a Free Preview</a>
      </nav>

      <a href="../#contact" class="whitespace-nowrap rounded-2xl bg-brand-700 px-3.5 py-2.5 text-sm font-semibold text-white md:hidden">Free Preview</a>
    </div>
  </header>

  <main>
    <section class="px-5 py-14 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">Privacy Policy</p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">Privacy Policy</h1>
        <p class="mt-6 text-lg leading-8 text-slate-600">
          FrontDoor Health respects your privacy. This Privacy Policy explains how we collect, use, and protect information when you visit our website or request a website preview.
        </p>

        <div class="mt-10 space-y-10 rounded-[32px] bg-white/90 p-7 shadow-[0_16px_60px_rgba(15,23,42,0.08)] md:p-10">
          <section>
            <h2 class="text-2xl font-bold tracking-tight">Information We Collect</h2>
            <p class="mt-4 text-base leading-7 text-slate-600">
              When you contact us or request a personalized website preview, we may collect information such as:
            </p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-base leading-7 text-slate-600">
              <li>Name</li>
              <li>Email address</li>
              <li>Phone number</li>
              <li>Practice name</li>
              <li>Website URL</li>
              <li>Information you voluntarily provide</li>
            </ul>
            <p class="mt-4 text-base leading-7 text-slate-600">
              We also collect limited website usage information to understand how visitors interact with our website and improve our services.
            </p>
          </section>

          <section class="border-t border-slate-200 pt-10">
            <h2 class="text-2xl font-bold tracking-tight">Analytics and Cookies</h2>
            <div class="mt-4 space-y-4 text-base leading-7 text-slate-600">
              <p>FrontDoor Health uses cookies and similar technologies to improve website functionality, understand visitor behavior, and measure the effectiveness of our marketing.</p>
              <p>We use Google Ads Conversion Tracking to understand whether visitors who click our advertisements later submit a website preview request or contact us.</p>
              <p>Google may place cookies on your device to measure advertising performance. These cookies do not provide us with access to your personal accounts or passwords.</p>
              <p>You can control or disable cookies through your browser settings. Disabling cookies may affect certain website functionality and measurement.</p>
            </div>
          </section>

          <section class="border-t border-slate-200 pt-10">
            <h2 class="text-2xl font-bold tracking-tight">How We Use Your Information</h2>
            <p class="mt-4 text-base leading-7 text-slate-600">We use information we collect to:</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-base leading-7 text-slate-600">
              <li>Respond to inquiries</li>
              <li>Prepare personalized website previews</li>
              <li>Improve our website</li>
              <li>Measure marketing effectiveness</li>
              <li>Communicate with prospective clients</li>
            </ul>
            <p class="mt-4 text-base leading-7 text-slate-600">We do not sell your personal information.</p>
          </section>

          <section class="border-t border-slate-200 pt-10">
            <h2 class="text-2xl font-bold tracking-tight">Healthcare Disclaimer</h2>
            <div class="mt-4 space-y-4 text-base leading-7 text-slate-600">
              <p>FrontDoor Health provides website design and marketing services for independent medical practices.</p>
              <p>FrontDoor Health does <strong>not</strong> provide medical care, diagnosis, treatment, or medical advice.</p>
            </div>
          </section>

          <section class="border-t border-slate-200 pt-10">
            <h2 class="text-2xl font-bold tracking-tight">Contact</h2>
            <p class="mt-4 text-base leading-7 text-slate-600">Questions about this Privacy Policy may be sent to:</p>
            <p class="mt-3 text-base font-semibold text-brand-700"><a href="mailto:chaitanya@frontdoor.health">chaitanya@frontdoor.health</a></p>
          </section>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-warm-200 px-5 py-8 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 border-t border-slate-200 pt-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="font-semibold">FrontDoor Health</p>
        <p class="mt-1 text-sm text-slate-500">
          A Website That Feels Like Your Practice
        </p>
      </div>
      <div class="flex gap-6 text-sm text-slate-500">
        <a href="../">Home</a>
        <a href="./">Privacy</a>
        <a href="../#contact">Contact</a>
      </div>
    </div>
  </footer>
</MarketingLayout>
