---
import HomeHeader from '../../../../components/marketing/HomeHeader.astro';
import MarketingFooter from '../../../../components/marketing/MarketingFooter.astro';
import PreviewRequestForm from '../../../../components/marketing/PreviewRequestForm.astro';
import MarketingLayout from '../../../../layouts/MarketingLayout.astro';
import { loadMarketingData, marketingCanonical } from '../../../../lib/marketing-data.mjs';

const { marketing } = await loadMarketingData(process.cwd());
const title = 'Mental Health Websites & Launch Package | FrontDoor Health';
const description = 'FrontDoor Health writes, designs, and maintains websites for solo and group mental health practices. Explore examples, compare prices, and request your free preview.';
const canonical = marketingCanonical(marketing, 'mental-health-website-design');
const examples = [
  {
    name: 'Maya Bennett Psychology',
    label: 'Solo Practice',
    slug: 'mayabennett',
    image: 'maya-desktop.webp',
    alt: 'Maya Bennett Psychology homepage with a quiet landscape and an introduction to the practice’s approach to therapy.',
    description: 'Meet Dr. Bennett, explore her approach, and check fees before requesting a consultation.',
  },
  {
    name: 'Westlake Psychiatry & Therapy',
    label: 'Group Practice',
    slug: 'westlakepsychiatry',
    image: 'westlake-desktop.webp',
    alt: 'Westlake Psychiatry & Therapy website introducing psychiatry, therapy, and a multidisciplinary care team.',
    description: 'Meet the team, compare services, and check insurance before requesting an appointment.',
  },
];
const plans = [
  { name: 'Solo practice', price: '$2,000', scope: 'Up to 5 pages, including your clinician profile and services.' },
  { name: 'Group practice', price: '$5,000', scope: 'Up to 12 pages and 5 clinician profiles, including a team directory.' },
];
const previewCta = 'Request your free preview';
const faqs = [
  ['Can you help if I’m opening a new practice?', 'Yes. We can start with your practice details and help you choose a domain, even if this is your first website.'],
  ['Can you replace my existing website?', 'Yes. We review your current pages and patient links, then build a preview so you can see the proposed changes.'],
  ['Can patients keep using our current EHR or scheduler?', 'In most cases, yes. We link to your existing patient portal, scheduling, intake, or payment tools. We confirm which links your systems support before you commit.'],
  ['When will my website be ready?', 'We’ll confirm your launch schedule after reviewing the scope and before you commit.'],
  ['What if a clinician joins or leaves after launch?', 'We can add or retire their profile and update the team directory. We’ll confirm the scope of ongoing updates with you before launch.'],
];
---

<MarketingLayout
  assetPrefix=".."
  bodyClass="bg-warm-50 font-sans text-slate-950 antialiased"
  canonical={canonical}
  description={description}
  image={new URL('/assets/mental-health/maya-desktop.webp', canonical).toString()}
  imageAlt={examples[0].alt}
  includeGoogleAdsConversion
  includeLucide
  includeTurnstile
  locale={marketing.seo.locale}
  siteName={marketing.seo.siteName}
  title={title}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Online launch package for mental health practices',
    serviceType: 'Website design, domain setup, business profile setup, search visibility, hosting, and maintenance',
    description,
    url: canonical,
    provider: { '@type': 'Organization', name: 'FrontDoor Health', url: marketingCanonical(marketing) },
  }}
>
  <HomeHeader homeHref="../" assetPrefix=".." previewLabel={previewCta} sectionLabel="Packages and pricing" />
  <main id="main-content" tabindex="-1">
    <section class="overflow-hidden bg-warm-100 px-5 py-14 lg:px-8 lg:py-20">
      <div class="mx-auto grid max-w-7xl gap-y-5 lg:grid-cols-[1fr_1fr] lg:gap-x-16">
        <div>
          <h1 class="text-[2.65rem] font-bold leading-[1.06] tracking-tight md:text-6xl lg:text-[4rem]">Websites for mental health practices</h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">We write, design, and maintain your website. Patients can get to know your clinicians, find fees and insurance information, and request an appointment.</p>
          <div class="mt-8 flex flex-col gap-3 sm:items-start">
            <a href="#contact" class="inline-flex justify-center rounded-2xl bg-brand-700 px-6 py-3.5 font-semibold text-white shadow-sm hover:bg-brand-900">{previewCta}</a>
            <p class="text-sm leading-6 text-slate-600">See what your site could look like before you commit.</p>
          </div>
        </div>
        <div class="aspect-video self-center lg:col-start-2 lg:row-start-1 lg:row-span-2 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xl">
          <a id="practice-overview" href="https://video.frontdoor.health/frontdoor-mental-health-720p.mp4" class="group relative block h-full w-full focus-visible:outline-offset-[-4px]">
            <img src="../assets/mental-health/overview.webp" width="896" height="504" alt="" fetchpriority="high" class="block h-full w-full" />
            <span class="overview-play"><span aria-hidden="true">▶</span> Watch the 1-minute overview</span>
            <span id="video-retry" hidden role="status" class="absolute inset-x-0 bottom-0 bg-brand-900 px-3 py-2 text-center text-sm text-white">Video couldn’t load. Select to retry.</span>
            <span aria-hidden="true" class="absolute bottom-3 right-3 rounded bg-brand-900 px-2 py-1 text-xs font-semibold text-white">0:58</span>
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="#examples" class="inline-flex min-h-[44px] items-center gap-2 font-semibold text-brand-700 underline decoration-brand-700/30 underline-offset-4 hover:text-brand-900">View Example Websites <span aria-hidden="true">↓</span></a>
          <a href="#pricing" class="inline-flex min-h-[44px] items-center text-sm text-slate-600 underline underline-offset-4 hover:text-brand-900">View pricing</a>
        </div>
      </div>
    </section>

    <section id="examples" class="bg-warm-100 px-5 py-16 lg:px-8 lg:py-20">
      <div class="mx-auto max-w-7xl">
        <div class="max-w-3xl">
          <h2 class="text-3xl font-bold leading-tight tracking-tight md:text-5xl">See what patients can do on your website</h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">Step inside these two fictional practices as a patient would.</p>
        </div>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {examples.map((example) => (
            <article class="min-w-0 overflow-hidden rounded-[28px] border border-slate-200 bg-warm-50">
              <a href={`../previews/${example.slug}/?preview_source=mental-health-website-design&utm_source=frontdoor.health&utm_medium=referral&utm_campaign=mental-health-website-design&utm_content=${example.slug}`} class="group block rounded-[28px] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-brand-700" aria-label={`Explore the ${example.label.toLowerCase()}: ${example.name}`}>
                <div class="border-b border-slate-200 bg-warm-200 p-4 sm:p-6">
                  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <p class="text-sm font-semibold uppercase tracking-wide text-sage-700">{example.label}</p>
                    <span class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl bg-brand-700 px-4 py-3 text-sm font-semibold text-white group-hover:bg-brand-900">Explore the {example.label.toLowerCase()} <span aria-hidden="true">→</span></span>
                  </div>
                  <img src={`../assets/mental-health/${example.image}`} width="1440" height="1000" alt={example.alt} loading="lazy" class="w-full rounded-lg border border-slate-200 shadow-sm" />
                </div>
                <div class="p-6 sm:p-8">
                  <h3 class="text-2xl font-bold tracking-tight">{example.name}</h3>
                  <p class="mt-4 text-base leading-7 text-slate-600">{example.description}</p>
                </div>
              </a>
            </article>
          ))}
        </div>
        <a href="#contact" class="mt-8 inline-flex justify-center rounded-2xl bg-brand-700 px-6 py-3.5 font-semibold text-white hover:bg-brand-900">{previewCta}</a>
      </div>
    </section>

    <section id="pricing" class="bg-warm-100 px-5 py-16 lg:px-8 lg:py-20" aria-labelledby="pricing-title">
      <div class="mx-auto max-w-7xl">
        <div id="what" class="scroll-mt-24"><h2 id="pricing-title" class="text-3xl font-bold tracking-tight md:text-5xl">What does a practice website cost?</h2></div>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">For psychiatrists, psychologists, nurse practitioners, therapists, and counselors in solo and group practices.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {plans.map(plan => (
            <article class="flex flex-col items-start rounded-[28px] border border-slate-200 bg-white p-6 sm:p-8">
              <h3 class="text-2xl font-bold">{plan.name}</h3>
              <p class="mt-4 text-4xl font-bold text-brand-700">{plan.price}</p>
              <p class="mt-1 text-sm text-slate-600">One-time design and launch fee</p>
              <p class="my-5 flex-1 text-base leading-7">{plan.scope}</p>
              <a href="#contact" class="rounded-2xl bg-brand-700 px-5 py-3 font-semibold text-white hover:bg-brand-900">{previewCta}</a>
            </article>
          ))}
        </div>
        <details id="launch-package" open class="group mt-6 scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
          <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-4 text-xl font-bold">
            What’s included in both packages?
            <span aria-hidden="true" class="text-2xl font-normal text-sage-700 group-open:rotate-45">+</span>
          </summary>
          <ul class="mt-3 list-disc space-y-1 pl-5 text-base leading-7 text-slate-600">
            <li>We write, design, and launch a site that’s easy to use on phones.</li>
            <li>We connect your domain and help patients find you in search.</li>
            <li>We set up or update your Google Business Profile if your practice qualifies.</li>
            <li>We link to the tools patients use to book, fill out forms, and pay.</li>
          </ul>
        </details>
        <div class="mt-6 rounded-2xl bg-sage-100 p-6 sm:p-8">
          <h3 class="text-xl font-bold">Hosting and maintenance for either plan · $49/month</h3>
          <p class="mt-2 text-base leading-7">Includes hosting, security, troubleshooting, and routine updates to your hours, services, and clinician profiles.</p>
        </div>
      </div>
    </section>

    <PreviewRequestForm
      fixedSpecialty="Mental Health"
      heading="See a website preview for your practice"
      showEyebrow={false}
      submitText={previewCta}
    >
      <div slot="summary" class="mt-5 text-lg leading-8 text-blue-100">
        <ol class="list-decimal space-y-3 pl-6">
          <li>Tell us about your practice.</li>
          <li>We’ll email you to confirm what you need.</li>
          <li>We’ll send you a link to your personalized preview.</li>
        </ol>
        <p class="mt-6">You decide whether to move forward after you’ve seen it.</p>
      </div>
    </PreviewRequestForm>

    <section class="bg-white px-5 py-16 lg:px-8 lg:py-20" aria-labelledby="faq-title">
      <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <div>
          <h2 id="faq-title" class="text-3xl font-bold leading-tight tracking-tight md:text-5xl">Common questions</h2>
        </div>
        <div class="divide-y divide-slate-200 border-y border-slate-200">
          {faqs.map(([question, answer], index) => (
            <details class="group py-5" open={index === 0}>
              <summary class="flex min-h-[44px] cursor-pointer list-none items-center justify-between gap-5 text-lg font-semibold leading-7 tracking-tight">
                {question}<span class="shrink-0 text-2xl font-normal text-sage-700 group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 pr-8 text-base leading-7 text-slate-600">{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <MarketingFooter homeHref="../" privacyHref="../privacy/" contactHref="#contact" showHome />

  <style is:inline>
    #practice-overview { position: relative; display: block; }
    #practice-overview .overview-play {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1rem;
      border-radius: 2rem;
      background: #1e395d;
      color: white;
      font-size: 0.875rem;
      font-weight: 600;
      white-space: nowrap;
    }
  </style>

  <script is:inline>
    const form = document.getElementById('preview-request-form');
    const production = ['frontdoor.health', 'www.frontdoor.health'].includes(location.hostname);
    if (production) {
      // Reuse the same anonymous tab session across visits to the example sites.
      let session = crypto.randomUUID();
      try {
        session = sessionStorage.getItem('fdh_session_id') || session;
        sessionStorage.setItem('fdh_session_id', session);
      } catch { /* When storage is unavailable, correlate within this page only. */ }
      form.dataset.analyticsSession = session;
    }

    function trackOverview(eventType) {
      if (!production) return;
      let campaign;
      try { campaign = window.FrontdoorAttribution?.getUtmCampaign?.(); } catch {}
      if (eventType === 'page_view' && !campaign) return;
      fetch('https://analytics.frontdoor.health/event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        keepalive: true,
        body: JSON.stringify({
          practice_slug: 'frontdoor-health', event_type: eventType,
          page_path: location.pathname, session_id: form.dataset.analyticsSession,
          utm_campaign: campaign, timestamp: new Date().toISOString(),
        }),
      }).catch(() => {});
    }
    trackOverview('page_view');
    let started = false;
    document.getElementById('practice-overview').addEventListener('click', (event) => {
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const link = event.currentTarget;
      const player = document.createElement('video');
      player.controls = true;
      player.playsInline = true;
      player.src = link.href;
      player.poster = link.querySelector('img').src;
      player.setAttribute('aria-label', 'FrontDoor Health website overview for mental health practices');
      player.className = 'block h-full w-full';
      player.addEventListener('playing', () => {
        if (!started) {
          started = true;
          trackOverview('video_start');
        }
      }, { once: true });
      player.addEventListener('error', () => {
        const restoreFocus = document.activeElement === player;
        link.querySelector('#video-retry').hidden = false;
        player.replaceWith(link);
        if (restoreFocus) link.focus();
      }, { once: true });
      link.replaceWith(player);
      player.play().catch(() => {}); // Native controls remain available if autoplay is blocked.
      player.focus();
    });

    const landingUtms = [...new URLSearchParams(window.location.search)]
      .filter(([key, value]) => key.startsWith('utm_') && value);
    const exampleCampaign = window.FrontdoorAttribution?.getUtmCampaign?.();
    document.querySelectorAll('#examples article > a').forEach((link) => {
      const url = new URL(link.href);
      if (exampleCampaign) url.searchParams.set('utm_campaign', exampleCampaign);
      // Explicit landing-page tags take priority over the example defaults and stored campaign.
      for (const [key, value] of landingUtms) url.searchParams.set(key, value);
      link.href = url.href;
    });
  </script>
</MarketingLayout>
