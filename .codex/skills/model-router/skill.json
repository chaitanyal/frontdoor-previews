{
  "name": "Frontdoor Previews Exact Router",
  "description": "Strict project-level overrides matching the expanded FrontDoor use-case matrix.",
  "extends": "~/.codex/skills/model-router/skill.json",
  "version": "1.0.0",
  "routing_rules": {
    "gpt-6-luna": {
      "keywords": [
        "copy",
        "provider profiles",
        "hours",
        "links",
        "FAQs",
        "practice.json",
        "$whois"
      ],
      "use_cases": [
        "copy_edits",
        "small_updates_to_existing_practice_json",
        "single_domain_whois_assessment"
      ],
      "is_entry_point": true,
      "escalation_conditions": {
        "gpt-6.1-sol": [
          "sources_conflict",
          "clinical_wording_needs_judgment",
          "several_pages_are_affected",
          "shared_behavior_is_affected",
          "infrastructure_findings_are_ambiguous"
        ]
      }
    },
    "gpt-6.1-sol": {
      "keywords": [
        "Astro components",
        "schemas",
        "layouts",
        "Cloudflare Worker",
        "analytics",
        "deployment script",
        "verified script",
        "build failures"
      ],
      "use_cases": [
        "new_practice_json_from_assessments",
        "shared_astro_components_schemas_layouts",
        "cloudflare_worker_or_analytics_changes",
        "deployment_script_changes",
        "routine_deployment_using_existing_verified_script",
        "difficult_build_failures_or_architecture_work"
      ],
      "is_entry_point": true,
      "escalation_conditions": {
        "astra": [
          "evidence_is_unusually_complex",
          "evidence_is_contradictory",
          "change_spans_multiple_systems",
          "changing_data_handling",
          "changing_security",
          "changing_production_architecture",
          "changing_dns",
          "migrations",
          "rollback_behavior",
          "production_cutover",
          "unexpected_production_issue_appears",
          "focused_investigation_stalls"
        ]
      }
    },
    "astra": {
      "is_entry_point": false,
      "constraints": "Never start here. Only escalate here from Sol when architecture boundaries break down or investigation traces stall out entirely."
    }
  },
  "execution_directives": {
    "workload_strategy": "Luna for contained content work. Sol for implementation or deployment to conserve usage.",
    "reasoning_effort_allocation": "Start at default reasoning effort and raise it only when the task warrants it."
  }
}
